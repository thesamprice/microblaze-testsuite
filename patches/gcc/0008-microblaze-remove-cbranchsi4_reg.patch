diff --git a/gcc/testsuite/gcc.target/microblaze/others/cbranch-eq-reg.c b/gcc/testsuite/gcc.target/microblaze/others/cbranch-eq-reg.c
new file mode 100644
index 000000000..6328900d6
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/cbranch-eq-reg.c
@@ -0,0 +1,63 @@
+/* { dg-do run } */
+/* { dg-options "-mxl-pattern-compare -save-temps" } */
+/* { dg-final { scan-assembler "pcmpeq" } } */
+/* { dg-final { scan-assembler "pcmpne" } } */
+
+/* The removed cbranchsi4_reg expanded a == b between two registers as
+   pcmpeq, which gives 1 when they are equal, then a branch taken when that
+   is 0: the branch went the wrong way.  Nothing used it.  Check equality
+   branches and values between registers with pattern compare enabled, where
+   pcmpeq and pcmpne are available, both ways round.  */
+
+extern void abort (void);
+
+__attribute__ ((noipa)) int
+br_eq (int a, int b)
+{
+  if (a == b)
+    return 1;
+  return 2;
+}
+
+__attribute__ ((noipa)) int
+br_ne (int a, int b)
+{
+  if (a != b)
+    return 1;
+  return 2;
+}
+
+__attribute__ ((noipa)) int
+val_eq (int a, int b)
+{
+  return a == b;
+}
+
+__attribute__ ((noipa)) int
+val_ne (int a, int b)
+{
+  return a != b;
+}
+
+static const int vals[] = { 0, 1, -1, 0x7fffffff, (int) 0x80000000, 100 };
+
+int
+main (void)
+{
+  unsigned int i, j;
+  for (i = 0; i < sizeof vals / sizeof vals[0]; i++)
+    for (j = 0; j < sizeof vals / sizeof vals[0]; j++)
+      {
+	int a = vals[i], b = vals[j];
+	int eq = i == j;
+	if (br_eq (a, b) != (eq ? 1 : 2))
+	  abort ();
+	if (br_ne (a, b) != (eq ? 2 : 1))
+	  abort ();
+	if (val_eq (a, b) != eq)
+	  abort ();
+	if (val_ne (a, b) != !eq)
+	  abort ();
+      }
+  return 0;
+}
