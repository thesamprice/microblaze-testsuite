+++ b/gcc/testsuite/gcc.target/microblaze/isa/fcmp1.c
@@ -1,5 +1,7 @@
 /* { dg-options "-O3 -mcpu=v10.0 -mhard-float" } */
 
+extern void print (const char *);
+
 volatile float f1, f2, f3;
 
 void float_func () 
