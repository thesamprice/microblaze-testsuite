From ec4380218db7a6c4ff59add78649839fef7f1f80 Mon Sep 17 00:00:00 2001
From: Samuel Price <thesamprice@gmail.com>
Date: Sun, 15 Nov 2026 13:38:03 -0500
Subject: [PATCH 4/5] microblaze: count a TImode argument as four words

microblaze_function_arg_advance grouped TImode with QImode, HImode and
SImode and advanced by one word.  TImode is what a 16-byte vector gets,
and microblaze_function_arg gives it four registers, so the next
argument was assigned a register that also held part of the vector.
For f (int a, v4si v, int b), v is in r6-r9 but b was read from r7, and
a caller put 11 (v[1]) there and never passed b.  This was wrong code,
not an ABI anything could depend on (gcc.dg/torture/va-arg-25.c,
gcc.dg/torture/vector-2.c, gcc.dg/torture/pr86363.c,
gcc.dg/torture/pr128142.c, gcc.dg/pr80286.c).

Advance by four words for TImode.

Assisted-by: Claude <noreply@anthropic.com>

gcc/ChangeLog:

	* config/microblaze/microblaze.cc (microblaze_function_arg_advance):
	Advance by four words for TImode.

gcc/testsuite/ChangeLog:

	* gcc.target/microblaze/others/timode-arg-run.c: New test.
---
 gcc/config/microblaze/microblaze.cc           |  6 +-
 .../microblaze/others/timode-arg-run.c        | 57 +++++++++++++++++++
 2 files changed, 62 insertions(+), 1 deletion(-)
 create mode 100644 gcc/testsuite/gcc.target/microblaze/others/timode-arg-run.c

diff --git a/gcc/config/microblaze/microblaze.cc b/gcc/config/microblaze/microblaze.cc
index e261ca3fb..80565741e 100644
--- a/gcc/config/microblaze/microblaze.cc
+++ b/gcc/config/microblaze/microblaze.cc
@@ -1637,10 +1637,14 @@ microblaze_function_arg_advance (cumulative_args_t cum_v,
       cum->arg_words += 2;
       break;
 
+    case E_TImode:
+      cum->gp_reg_found = 1;
+      cum->arg_words += 4;
+      break;
+
     case E_QImode:
     case E_HImode:
     case E_SImode:
-    case E_TImode:
       cum->gp_reg_found = 1;
       cum->arg_words++;
       break;
diff --git a/gcc/testsuite/gcc.target/microblaze/others/timode-arg-run.c b/gcc/testsuite/gcc.target/microblaze/others/timode-arg-run.c
new file mode 100644
index 000000000..2aab2c021
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/timode-arg-run.c
@@ -0,0 +1,57 @@
+/* A 16-byte vector has TImode.  microblaze_function_arg_advance counted
+   a TImode argument as one word instead of four, so the next argument
+   was given a register the vector also used (gcc.dg/torture/va-arg-25.c,
+   gcc.dg/torture/vector-2.c, gcc.dg/torture/pr86363.c,
+   gcc.dg/torture/pr128142.c, gcc.dg/pr80286.c).  */
+/* { dg-do run } */
+/* { dg-options "-Wno-psabi" } */
+
+#include <stdarg.h>
+
+typedef unsigned int v4si __attribute__ ((vector_size (16)));
+
+__attribute__ ((noipa)) int
+after (int a, v4si v, int b)
+{
+  return a == 1 && v[0] == 10 && v[1] == 11 && v[2] == 12 && v[3] == 13
+	 && b == 2;
+}
+
+/* The vector straddles the last argument registers and the stack.  */
+__attribute__ ((noipa)) int
+split (int a, int b, int c, int d, v4si v, int e)
+{
+  return a == 1 && b == 2 && c == 3 && d == 4
+	 && v[0] == 10 && v[1] == 11 && v[2] == 12 && v[3] == 13 && e == 5;
+}
+
+__attribute__ ((noipa)) int
+var (int a, ...)
+{
+  va_list ap;
+  v4si v, w;
+  int b;
+
+  va_start (ap, a);
+  v = va_arg (ap, v4si);
+  b = va_arg (ap, int);
+  w = va_arg (ap, v4si);
+  va_end (ap);
+  return a == 1 && v[0] == 10 && v[3] == 13 && b == 2
+	 && w[0] == 20 && w[3] == 23;
+}
+
+int
+main (void)
+{
+  v4si v = { 10, 11, 12, 13 };
+  v4si w = { 20, 21, 22, 23 };
+
+  if (!after (1, v, 2))
+    __builtin_abort ();
+  if (!split (1, 2, 3, 4, v, 5))
+    __builtin_abort ();
+  if (!var (1, v, 2, w))
+    __builtin_abort ();
+  return 0;
+}
