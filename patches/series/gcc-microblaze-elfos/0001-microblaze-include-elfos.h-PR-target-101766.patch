diff --git a/gcc/testsuite/gcc.target/microblaze/others/elf-size-flex.c b/gcc/testsuite/gcc.target/microblaze/others/elf-size-flex.c
new file mode 100644
index 000000000..9bdf7eda0
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/elf-size-flex.c
@@ -0,0 +1,11 @@
+/* The .size of an object with an initialized flexible array member
+   includes the initializer, not just the size of its type.  */
+
+/* { dg-do compile } */
+/* { dg-skip-if "no assembly" { *-*-* } { "-fno-fat-lto-objects" } { "" } } */
+/* { dg-options "" } */
+
+struct s { int n; int a[]; };
+struct s x = { 2, { 3, 4 } };
+
+/* { dg-final { scan-assembler "\\.size\tx, 12" } } */
diff --git a/gcc/testsuite/gcc.target/microblaze/others/elf-symver.c b/gcc/testsuite/gcc.target/microblaze/others/elf-symver.c
new file mode 100644
index 000000000..c4661754e
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/elf-symver.c
@@ -0,0 +1,22 @@
+/* MicroBlaze is an ELF target: __ELF__ is defined, and the symver
+   attribute, which __has_attribute reports, emits .symver.  */
+
+/* { dg-do compile } */
+/* { dg-skip-if "no assembly" { *-*-* } { "-fno-fat-lto-objects" } { "" } } */
+
+#ifndef __ELF__
+#error __ELF__ is not defined
+#endif
+
+#if !__has_attribute (symver)
+#error symver is not supported
+#endif
+
+__attribute__ ((symver ("foo@VERS_1")))
+int
+foo_v1 (void)
+{
+  return 1;
+}
+
+/* { dg-final { scan-assembler "\\.symver\tfoo_v1, foo@VERS_1" } } */
