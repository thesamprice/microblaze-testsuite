diff --git a/gcc/testsuite/gcc.target/microblaze/isa/dword-odd-pair.c b/gcc/testsuite/gcc.target/microblaze/isa/dword-odd-pair.c
new file mode 100644
index 000000000..66e33d86f
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/isa/dword-odd-pair.c
@@ -0,0 +1,12 @@
+/* 64-bit values may live in odd register pairs, so arguments in r5:r6
+   and r7:r8 and the result in r3:r4 need no copies.  */
+/* { dg-options "-O2" } */
+
+long long add (long long a, long long b) { return a + b; }
+long long sub (long long a, long long b) { return a - b; }
+long long neg (long long a) { return -a; }
+unsigned long long shl1 (unsigned long long a) { return a << 1; }
+long long add1 (long long a) { return a + 1; }
+
+/* { dg-final { scan-assembler-not {\taddk\t} } } */
+/* { dg-final { scan-assembler-not {\tor\t} } } */
diff --git a/gcc/testsuite/gcc.target/microblaze/others/dword-abi-run.c b/gcc/testsuite/gcc.target/microblaze/others/dword-abi-run.c
new file mode 100644
index 000000000..d04e425b3
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/dword-abi-run.c
@@ -0,0 +1,176 @@
+/* 64-bit arguments and results live in odd register pairs (r5:r6,
+   r6:r7 after an int, r3:r4 for the result), so the register allocator
+   may overlap a 64-bit result with an input by one word.  Check chains
+   of 64-bit operations and soft-float double moves against values done
+   a word at a time.  */
+/* { dg-do run } */
+/* { dg-options "-std=gnu99" } */
+
+extern void abort (void);
+
+typedef unsigned long long u64;
+typedef long long s64;
+typedef unsigned int u32;
+
+static const u64 vals[] = {
+  0, 1, 0x7fffffffULL, 0x80000000ULL, 0xffffffffULL, 0x100000000ULL,
+  0x180000001ULL, 0x7fffffffffffffffULL, 0x8000000000000000ULL,
+  0xffffffff00000000ULL, 0xffffffffffffffffULL, 0x0123456789abcdefULL
+};
+#define N (sizeof vals / sizeof vals[0])
+
+static u32 hi (u64 x) { return (u32) (x >> 32); }
+static u32 lo (u64 x) { return (u32) x; }
+static u64 mk (u32 h, u32 l) { return ((u64) h << 32) | l; }
+
+__attribute__ ((noipa)) static u64
+ref_add (u64 a, u64 b)
+{
+  u32 l = lo (a) + lo (b);
+  return mk (hi (a) + hi (b) + (l < lo (a)), l);
+}
+
+__attribute__ ((noipa)) static u64
+ref_neg (u64 a)
+{
+  return ref_add (mk (~hi (a), ~lo (a)), 1);
+}
+
+__attribute__ ((noipa)) static int
+ref_lts (u64 a, u64 b)
+{
+  if (hi (a) != hi (b))
+    return (int) hi (a) < (int) hi (b);
+  return lo (a) < lo (b);
+}
+
+__attribute__ ((noipa)) u64 f_add (u64 a, u64 b) { return a + b; }
+__attribute__ ((noipa)) u64 f_sub (u64 a, u64 b) { return a - b; }
+__attribute__ ((noipa)) u64 f_neg (u64 a) { return -a; }
+__attribute__ ((noipa)) u64 f_not (u64 a) { return ~a; }
+__attribute__ ((noipa)) u64 f_shl (u64 a) { return a << 1; }
+__attribute__ ((noipa)) u64 f_shr (u64 a) { return a >> 1; }
+__attribute__ ((noipa)) s64 f_sar (s64 a) { return a >> 1; }
+__attribute__ ((noipa)) u64 f_add1 (u64 a) { return a + 1; }
+__attribute__ ((noipa)) u64 f_iadd (int i, u64 a) { return a + i; }
+__attribute__ ((noipa)) u64 f_iswap (int i, u64 a) { return (a << 32) | (a >> 32); }
+__attribute__ ((noipa)) s64 f_ext (int i) { return i; }
+__attribute__ ((noipa)) u64 f_zext (u32 i) { return i; }
+__attribute__ ((noipa)) int f_lt (s64 a, s64 b) { return a < b; }
+__attribute__ ((noipa)) u64 f_min (s64 a, s64 b) { return a < b ? a : b; }
+__attribute__ ((noipa)) u64 f_mul (u32 a, u32 b) { return (u64) a * b; }
+__attribute__ ((noipa)) s64 f_smul (int a, int b) { return (s64) a * b; }
+
+/* A chain in which each result feeds the next operation.  */
+__attribute__ ((noipa)) u64
+f_chain (u64 a, u64 b)
+{
+  u64 x = a + b;
+  x = -x;
+  x = ~x + a;
+  x = (x << 1) - b;
+  x = (x >> 1) + (u64) ((s64) a >> 1);
+  return x;
+}
+
+__attribute__ ((noipa)) static u64
+ref_chain (u64 a, u64 b)
+{
+  u64 x = ref_add (a, b);
+  x = ref_neg (x);
+  x = ref_add (mk (~hi (x), ~lo (x)), a);
+  x = ref_add (mk ((hi (x) << 1) | (lo (x) >> 31), lo (x) << 1), ref_neg (b));
+  x = mk (hi (x) >> 1, (lo (x) >> 1) | (hi (x) << 31));
+  return ref_add (x, mk ((hi (a) >> 1) | (hi (a) & 0x80000000u),
+			 (lo (a) >> 1) | (hi (a) << 31)));
+}
+
+/* Rotate three 64-bit values through the argument registers.  */
+__attribute__ ((noipa)) u64
+f_rot (int n, u64 a, u64 b, u64 c)
+{
+  while (n-- > 0)
+    {
+      u64 t = a;
+      a = b + 1;
+      b = c;
+      c = t;
+    }
+  return a ^ (b << 1) ^ (c >> 1);
+}
+
+__attribute__ ((noipa)) double d_id (double x) { return x; }
+__attribute__ ((noipa)) double d_second (double x, double y) { return y; }
+__attribute__ ((noipa)) double d_isecond (int i, double x) { return x; }
+__attribute__ ((noipa)) double d_neg (double x) { return -x; }
+__attribute__ ((noipa)) double d_sel (int c, double x, double y)
+{
+  return c ? x : y;
+}
+
+union du { double d; u64 u; };
+
+int
+main (void)
+{
+  unsigned int i, j;
+  for (i = 0; i < N; i++)
+    {
+      u64 a = vals[i];
+      if (f_neg (a) != ref_neg (a) || f_not (a) != mk (~hi (a), ~lo (a))
+	  || f_shl (a) != mk ((hi (a) << 1) | (lo (a) >> 31), lo (a) << 1)
+	  || f_shr (a) != mk (hi (a) >> 1, (lo (a) >> 1) | (hi (a) << 31))
+	  || (u64) f_sar (a) != mk ((hi (a) >> 1) | (hi (a) & 0x80000000u),
+				    (lo (a) >> 1) | (hi (a) << 31))
+	  || f_add1 (a) != ref_add (a, 1)
+	  || f_iadd ((int) lo (a), a) != ref_add (a, (u64) (s64) (int) lo (a))
+	  || f_iswap (0, a) != mk (lo (a), hi (a))
+	  || (u64) f_ext ((int) lo (a)) != (u64) (s64) (int) lo (a)
+	  || f_zext (lo (a)) != lo (a)
+	  || f_mul (lo (a), hi (a)) != (u64) lo (a) * hi (a)
+	  || (u64) f_smul ((int) lo (a), (int) hi (a))
+	     != (u64) ((s64) (int) lo (a) * (int) hi (a)))
+	abort ();
+
+      union du x, y;
+      x.u = a;
+      y.u = ref_neg (a);
+      union du r;
+      r.d = d_id (x.d);
+      if (r.u != x.u)
+	abort ();
+      r.d = d_second (y.d, x.d);
+      if (r.u != x.u)
+	abort ();
+      r.d = d_isecond (1, x.d);
+      if (r.u != x.u)
+	abort ();
+      r.d = d_neg (x.d);
+      if (r.u != (x.u ^ 0x8000000000000000ULL))
+	abort ();
+      r.d = d_sel (0, x.d, y.d);
+      if (r.u != y.u)
+	abort ();
+      r.d = d_sel (1, x.d, y.d);
+      if (r.u != x.u)
+	abort ();
+
+      for (j = 0; j < N; j++)
+	{
+	  u64 b = vals[j];
+	  if (f_add (a, b) != ref_add (a, b)
+	      || f_sub (a, b) != ref_add (a, ref_neg (b))
+	      || f_lt (a, b) != ref_lts (a, b)
+	      || f_min (a, b) != (ref_lts (a, b) ? a : b)
+	      || f_chain (a, b) != ref_chain (a, b))
+	    abort ();
+	}
+    }
+
+  if (f_rot (0, 1, 2, 3) != (1 ^ (2 << 1) ^ (3 >> 1))
+      || f_rot (1, 0x100000000ULL, 0xffffffffULL, 7)
+	 != (0x100000000ULL ^ (7 << 1) ^ (0x100000000ULL >> 1))
+      || f_rot (2, 1, 2, 3) != (4 ^ (1 << 1) ^ (3 >> 1)))
+    abort ();
+  return 0;
+}
diff --git a/gcc/testsuite/gcc.target/microblaze/others/dword-overlap-run.c b/gcc/testsuite/gcc.target/microblaze/others/dword-overlap-run.c
new file mode 100644
index 000000000..b8b98ddc8
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/dword-overlap-run.c
@@ -0,0 +1,193 @@
+/* Double words may start at an odd register, so the result of a 64-bit
+   operation can overlap an input by one word.  Force each such overlap
+   with register variables and check the result against the same
+   operation done a word at a time.  */
+/* { dg-do run } */
+/* { dg-options "-std=gnu99" } */
+
+extern void abort (void);
+
+typedef unsigned long long u64;
+typedef long long s64;
+typedef unsigned int u32;
+
+static const u64 vals[] = {
+  0, 1, 2, 0x7fffffffULL, 0x80000000ULL, 0xfffffffeULL, 0xffffffffULL,
+  0x100000000ULL, 0x1ffffffffULL, 0x180000001ULL, 0x7fffffffffffffffULL,
+  0x8000000000000000ULL, 0x8000000180000001ULL, 0xffffffff00000000ULL,
+  0xfffffffffffffffeULL, 0xffffffffffffffffULL, 0x0123456789abcdefULL,
+  0xfedcba9876543210ULL
+};
+#define N (sizeof vals / sizeof vals[0])
+
+static u32 hi (u64 x) { return (u32) (x >> 32); }
+static u32 lo (u64 x) { return (u32) x; }
+static u64 mk (u32 h, u32 l) { return ((u64) h << 32) | l; }
+
+__attribute__ ((noipa)) static u64
+ref_add (u64 a, u64 b)
+{
+  u32 l = lo (a) + lo (b);
+  return mk (hi (a) + hi (b) + (l < lo (a)), l);
+}
+
+__attribute__ ((noipa)) static u64
+ref_neg (u64 a)
+{
+  return ref_add (mk (~hi (a), ~lo (a)), 1);
+}
+
+__attribute__ ((noipa)) static u64
+ref_sub (u64 a, u64 b)
+{
+  return ref_add (a, ref_neg (b));
+}
+
+__attribute__ ((noipa)) static u64
+ref_shl1 (u64 a)
+{
+  return mk ((hi (a) << 1) | (lo (a) >> 31), lo (a) << 1);
+}
+
+__attribute__ ((noipa)) static u64
+ref_lshr1 (u64 a)
+{
+  return mk (hi (a) >> 1, (lo (a) >> 1) | (hi (a) << 31));
+}
+
+__attribute__ ((noipa)) static u64
+ref_ashr1 (u64 a)
+{
+  return mk ((hi (a) >> 1) | (hi (a) & 0x80000000u),
+	     (lo (a) >> 1) | (hi (a) << 31));
+}
+
+/* D = OP (S) with D and S in the given registers.  */
+#define UN(name, D, S, expr)						\
+  __attribute__ ((noipa)) u64						\
+  name (u64 a)								\
+  {									\
+    register u64 s __asm__ (S) = a;					\
+    register u64 d __asm__ (D);						\
+    __asm__ ("" : "+r" (s));						\
+    d = expr;								\
+    __asm__ ("" : "+r" (d));						\
+    return d;								\
+  }
+
+/* D = A OP B with D, A and B in the given registers.  */
+#define BIN(name, D, A, B, expr)					\
+  __attribute__ ((noipa)) u64						\
+  name (u64 a, u64 b)							\
+  {									\
+    register u64 x __asm__ (A) = a;					\
+    register u64 y __asm__ (B) = b;					\
+    register u64 d __asm__ (D);						\
+    __asm__ ("" : "+r" (x), "+r" (y));					\
+    d = expr;								\
+    __asm__ ("" : "+r" (d));						\
+    return d;								\
+  }
+
+/* D = A + B, C = the carry out, for the overflow check.  */
+#define ADDV(name, D, A, B)						\
+  __attribute__ ((noipa)) u64						\
+  name (u64 a, u64 b, int *c)						\
+  {									\
+    register u64 x __asm__ (A) = a;					\
+    register u64 y __asm__ (B) = b;					\
+    register u64 d __asm__ (D);						\
+    __asm__ ("" : "+r" (x), "+r" (y));					\
+    u64 t;								\
+    *c = __builtin_add_overflow (x, y, &t);				\
+    d = t;								\
+    __asm__ ("" : "+r" (d));						\
+    return d;								\
+  }
+
+#define SUBV(name, D, A, B)						\
+  __attribute__ ((noipa)) u64						\
+  name (u64 a, u64 b, int *c)						\
+  {									\
+    register u64 x __asm__ (A) = a;					\
+    register u64 y __asm__ (B) = b;					\
+    register u64 d __asm__ (D);						\
+    __asm__ ("" : "+r" (x), "+r" (y));					\
+    u64 t;								\
+    *c = __builtin_sub_overflow (x, y, &t);				\
+    d = t;								\
+    __asm__ ("" : "+r" (d));						\
+    return d;								\
+  }
+
+/* The result one register below and one register above the input.  */
+#define UNARY(X)							\
+  X (neg, -s, ref_neg (a))						\
+  X (not, ~s, mk (~hi (a), ~lo (a)))					\
+  X (mov, s, a)								\
+  X (dbl, s + s, ref_add (a, a))					\
+  X (shl1, s << 1, ref_shl1 (a))					\
+  X (lshr1, s >> 1, ref_lshr1 (a))					\
+  X (ashr1, (u64) ((s64) s >> 1), ref_ashr1 (a))			\
+  X (addi1, s + 1, ref_add (a, 1))					\
+  X (addim1, s - 1, ref_add (a, -1ULL))					\
+  X (addibig, s + 0x123456789ULL, ref_add (a, 0x123456789ULL))		\
+  X (addihi, s + 0x500000000ULL, ref_add (a, 0x500000000ULL))		\
+  X (addilo, s + 0x80000000ULL, ref_add (a, 0x80000000ULL))
+
+#define DEF_UN(op, expr, ref)						\
+  UN (op##_dn, "r4", "r5", expr)					\
+  UN (op##_up, "r6", "r5", expr)					\
+  UN (op##_dn3, "r3", "r4", expr)					\
+  UN (op##_up3, "r4", "r3", expr)
+UNARY (DEF_UN)
+
+#define BINARY(X)							\
+  X (add, x + y, ref_add (a, b))					\
+  X (sub, x - y, ref_sub (a, b))
+
+#define DEF_BIN(op, expr, ref)						\
+  BIN (op##_1, "r4", "r5", "r7", expr)					\
+  BIN (op##_2, "r6", "r5", "r7", expr)					\
+  BIN (op##_3, "r4", "r7", "r5", expr)					\
+  BIN (op##_4, "r6", "r7", "r5", expr)
+BINARY (DEF_BIN)
+
+#define CARRY(X) X (1, "r4", "r5", "r7") X (2, "r6", "r5", "r7")	\
+  X (3, "r4", "r7", "r5") X (4, "r6", "r7", "r5")
+#define DEF_CARRY(n, D, A, B) ADDV (addv_##n, D, A, B) SUBV (subv_##n, D, A, B)
+CARRY (DEF_CARRY)
+
+int
+main (void)
+{
+  unsigned int i, j;
+  for (i = 0; i < N; i++)
+    {
+      u64 a = vals[i];
+#define CHECK_UN(op, expr, ref)						\
+      if (op##_dn (a) != ref || op##_up (a) != ref			\
+	  || op##_dn3 (a) != ref || op##_up3 (a) != ref)		\
+	abort ();
+      UNARY (CHECK_UN)
+
+      for (j = 0; j < N; j++)
+	{
+	  u64 b = vals[j];
+	  int c;
+#define CHECK_BIN(op, expr, ref)					\
+	  if (op##_1 (a, b) != ref || op##_2 (a, b) != ref		\
+	      || op##_3 (a, b) != ref || op##_4 (a, b) != ref)		\
+	    abort ();
+	  BINARY (CHECK_BIN)
+#define CHECK_CARRY(n, D, A, B)						\
+	  if (addv_##n (a, b, &c) != ref_add (a, b)			\
+	      || c != (ref_add (a, b) < a))				\
+	    abort ();							\
+	  if (subv_##n (a, b, &c) != ref_sub (a, b) || c != (a < b))	\
+	    abort ();
+	  CARRY (CHECK_CARRY)
+	}
+    }
+  return 0;
+}
-- 
