diff --git a/gcc/config/microblaze/constraints.md b/gcc/config/microblaze/constraints.md
index 0d57ad29c..263b53050 100644
--- a/gcc/config/microblaze/constraints.md
+++ b/gcc/config/microblaze/constraints.md
@@ -61,6 +61,11 @@
 
 ;; Define memory constraints
 
+(define_memory_constraint "Y"
+  "Memory operand addressed by a register or the sum of two registers."
+  (and (match_code "mem")
+       (match_test "microblaze_reorder_memory_p (op)")))
+
 (define_memory_constraint "R"
   "Memory operand which fits in single instruction."
   (and (match_code "mem")
diff --git a/gcc/config/microblaze/microblaze-protos.h b/gcc/config/microblaze/microblaze-protos.h
index acee3333b..90c532b1d 100644
--- a/gcc/config/microblaze/microblaze-protos.h
+++ b/gcc/config/microblaze/microblaze-protos.h
@@ -35,6 +35,8 @@ extern int microblaze_expand_shift (rtx *);
 extern bool microblaze_dword_overlap_p (rtx, bool, rtx, bool);
 extern const char *microblaze_output_adddi3_imm (rtx *);
 extern int microblaze_adddi3_imm_length (rtx *);
+extern bool microblaze_reorder_memory_p (rtx);
+extern const char *microblaze_output_reorder_mem (const char *, rtx, rtx);
 extern bool microblaze_expand_move (machine_mode, rtx *);
 extern bool microblaze_expand_block_move (rtx, rtx, rtx, rtx);
 extern bool microblaze_expand_strlen (rtx, rtx, rtx);
diff --git a/gcc/config/microblaze/microblaze.cc b/gcc/config/microblaze/microblaze.cc
index 63c7224e5..486207ac0 100644
--- a/gcc/config/microblaze/microblaze.cc
+++ b/gcc/config/microblaze/microblaze.cc
@@ -3663,6 +3663,45 @@ microblaze_adddi3_imm_length (rtx *operands)
   return len;
 }
 
+/* Return true if the memory operand OP is addressed by a register or
+   by the sum of two registers, the only addresses of the byte-reversed
+   loads and stores lwr and swr.  */
+bool
+microblaze_reorder_memory_p (rtx op)
+{
+  rtx addr = XEXP (op, 0);
+  if (REG_P (addr))
+    return true;
+  return (GET_CODE (addr) == PLUS
+	  && REG_P (XEXP (addr, 0))
+	  && REG_P (XEXP (addr, 1)));
+}
+
+/* Output the byte-reversed load or store INSN of the register REG at
+   the memory operand MEM.  */
+const char *
+microblaze_output_reorder_mem (const char *insn, rtx reg, rtx mem)
+{
+  rtx addr = XEXP (mem, 0);
+  rtx ops[3];
+  char buf[32];
+
+  ops[0] = reg;
+  if (REG_P (addr))
+    {
+      ops[1] = addr;
+      ops[2] = gen_rtx_REG (SImode, GP_REG_FIRST);
+    }
+  else
+    {
+      ops[1] = XEXP (addr, 0);
+      ops[2] = XEXP (addr, 1);
+    }
+  snprintf (buf, sizeof buf, "%s\t%%0,%%1,%%2", insn);
+  output_asm_insn (buf, ops);
+  return "";
+}
+
 /* Return an RTX indicating where the return address to the
    calling function can be found.  */
 rtx
diff --git a/gcc/config/microblaze/microblaze.md b/gcc/config/microblaze/microblaze.md
index 9801ecaa5..550911a9e 100644
--- a/gcc/config/microblaze/microblaze.md
+++ b/gcc/config/microblaze/microblaze.md
@@ -1233,17 +1233,30 @@
   }
 )
 
-;;Load and store reverse
-(define_insn "movsi4_rev"
-  [(set (match_operand:SI 0 "reg_or_mem_operand" "=r,Q")
-        (bswap:SI (match_operand:SF 1 "reg_or_mem_operand" "Q,r")))]
+;; Byte-reversed loads and stores of a word.  lwr and swr only have the
+;; register form, so the address is a register or the sum of two.
+
+(define_insn "*bswapsi2_load"
+  [(set (match_operand:SI 0 "register_operand" "=d")
+	(bswap:SI (match_operand:SI 1 "reorder_memory_operand" "Y")))]
   "TARGET_REORDER"
-  "@
-   lwr\t%0,%y1,r0
-   swr\t%1,%y0,r0"
-  [(set_attr "type"     "load,store")
-  (set_attr "mode"      "SI")
-  (set_attr "length"    "4,4")])
+  {
+    return microblaze_output_reorder_mem ("lwr", operands[0], operands[1]);
+  }
+  [(set_attr "type"	"load")
+   (set_attr "mode"	"SI")
+   (set_attr "length"	"4")])
+
+(define_insn "*bswapsi2_store"
+  [(set (match_operand:SI 0 "reorder_memory_operand" "=Y")
+	(bswap:SI (match_operand:SI 1 "register_operand" "d")))]
+  "TARGET_REORDER"
+  {
+    return microblaze_output_reorder_mem ("swr", operands[1], operands[0]);
+  }
+  [(set_attr "type"	"store")
+   (set_attr "mode"	"SI")
+   (set_attr "length"	"4")])
 
 ;; 32-bit floating point moves
 
diff --git a/gcc/config/microblaze/predicates.md b/gcc/config/microblaze/predicates.md
index accbb3cfa..18f004017 100644
--- a/gcc/config/microblaze/predicates.md
+++ b/gcc/config/microblaze/predicates.md
@@ -30,6 +30,10 @@
