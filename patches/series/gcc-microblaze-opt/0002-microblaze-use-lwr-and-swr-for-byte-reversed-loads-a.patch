 	    (match_test "LARGE_INT (op)"))))
 
+(define_predicate "reorder_memory_operand"
+  (and (match_operand 0 "memory_operand")
+       (match_test "microblaze_reorder_memory_p (op)")))
+
 (define_predicate "arith_plus_operand"
  (match_operand 0 "general_operand")
 {
diff --git a/gcc/testsuite/gcc.target/microblaze/isa/bswap-mem-noreorder.c b/gcc/testsuite/gcc.target/microblaze/isa/bswap-mem-noreorder.c
new file mode 100644
index 000000000..1abbc4ca2
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/isa/bswap-mem-noreorder.c
@@ -0,0 +1,11 @@
+/* Without the reorder instructions there is no lwr or swr.  */
+/* { dg-options "-O2 -mcpu=v8.20.a" } */
+/* { dg-skip-if "reorder requested" { *-*-* } { "-mxl-reorder" } { "" } } */
+
+typedef unsigned int u32;
+
+u32 load (const u32 *p) { return __builtin_bswap32 (*p); }
+void store (u32 *p, u32 x) { *p = __builtin_bswap32 (x); }
+
+/* { dg-final { scan-assembler-not {\tlwr\t} } } */
+/* { dg-final { scan-assembler-not {\tswr\t} } } */
diff --git a/gcc/testsuite/gcc.target/microblaze/isa/bswap-mem.c b/gcc/testsuite/gcc.target/microblaze/isa/bswap-mem.c
new file mode 100644
index 000000000..89e34a64c
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/isa/bswap-mem.c
@@ -0,0 +1,15 @@
+/* With the reorder instructions, a byte-reversed load or store of a
+   word addressed by a register or the sum of two registers is lwr or
+   swr.  */
+/* { dg-options "-O2 -mcpu=v10.0" } */
+
+typedef unsigned int u32;
+
+u32 load (const u32 *p) { return __builtin_bswap32 (*p); }
+u32 load_idx (const u32 *p, int i) { return __builtin_bswap32 (p[i]); }
+void store (u32 *p, u32 x) { *p = __builtin_bswap32 (x); }
+void store_idx (u32 *p, int i, u32 x) { p[i] = __builtin_bswap32 (x); }
+
+/* { dg-final { scan-assembler-times {\tlwr\tr[0-9]+,r[0-9]+,r[0-9]+\n} 2 } } */
+/* { dg-final { scan-assembler-times {\tswr\tr[0-9]+,r[0-9]+,r[0-9]+\n} 2 } } */
+/* { dg-final { scan-assembler-not {\tswapb\t} } } */
diff --git a/gcc/testsuite/gcc.target/microblaze/others/bswap-mem-run.c b/gcc/testsuite/gcc.target/microblaze/others/bswap-mem-run.c
new file mode 100644
index 000000000..aef077a62
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/bswap-mem-run.c
@@ -0,0 +1,61 @@
+/* Check byte-reversed loads and stores of words against byte accesses.  */
+/* { dg-do run } */
+
+extern void abort (void);
+
+typedef unsigned int u32;
+
+static u32 buf[4] __attribute__ ((aligned (4)));
+
+__attribute__ ((noipa)) u32 load (const u32 *p) { return __builtin_bswap32 (*p); }
+__attribute__ ((noipa)) u32 load_idx (const u32 *p, int i) { return __builtin_bswap32 (p[i]); }
+__attribute__ ((noipa)) void store (u32 *p, u32 x) { *p = __builtin_bswap32 (x); }
+__attribute__ ((noipa)) void store_idx (u32 *p, int i, u32 x) { p[i] = __builtin_bswap32 (x); }
+__attribute__ ((noipa)) u32 load_add (const u32 *p, u32 y) { return __builtin_bswap32 (*p) + y; }
+
+/* The value of the bytes at P read as a big-endian word.  */
+static u32
+be_bytes (const void *p)
+{
+  const unsigned char *b = p;
+  return ((u32) b[0] << 24) | ((u32) b[1] << 16) | ((u32) b[2] << 8) | b[3];
+}
+
+int
+main (void)
+{
+  static const unsigned char bytes[16] = {
+    0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef,
+    0xff, 0x00, 0x80, 0x7f, 0xde, 0xad, 0xbe, 0xef
+  };
+  const union { u32 w; unsigned char b[4]; } u = { 0x01020304 };
+  int le = u.b[0] == 4;
+  int i;
+
+  __builtin_memcpy (buf, bytes, sizeof buf);
+  for (i = 0; i < 4; i++)
+    {
+      /* Reversed, the bytes read in the other byte order.  */
+      u32 want = be_bytes (&bytes[4 * i]);
+      if (!le)
+	want = __builtin_bswap32 (want);
+      if (load (&buf[i]) != want || load_idx (buf, i) != want)
+	abort ();
+      if (load_add (&buf[i], 1) != want + 1)
+	abort ();
+    }
+
+  for (i = 0; i < 4; i++)
+    {
+      u32 x = 0x01234567u * (i + 1);
+      store (&buf[0], x);
+      if (buf[0] != __builtin_bswap32 (x))
+	abort ();
+      store_idx (buf, i, x);
+      if (buf[i] != __builtin_bswap32 (x))
+	abort ();
+      if (be_bytes (&buf[i]) != (le ? x : __builtin_bswap32 (x)))
+	abort ();
+    }
+  return 0;
+}
