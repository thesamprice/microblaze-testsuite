-	      insn = emit_move_insn (reg_rtx, mem_rtx);
+	      rtx_insn *restore = emit_move_insn (reg_rtx, mem_rtx);
+	      RTX_FRAME_RELATED_P (restore) = 1;
+	      add_reg_note (restore, REG_CFA_RESTORE, reg_rtx);
 	    }
 
 	  gp_offset += GET_MODE_SIZE (SImode);
@@ -3231,24 +3267,32 @@ microblaze_function_epilogue (FILE *file)
