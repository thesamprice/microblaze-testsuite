      stack pointer value.  */
 
   if (microblaze_can_use_return_insn ())
     {
-      emit_jump_insn (gen_return_internal (gen_rtx_REG (Pmode,
-							GP_REG_FIRST +
-							MB_ABI_SUB_RETURN_ADDR_REGNUM)));
+      if (!sibcall_p)
+	emit_jump_insn (gen_return_internal (gen_rtx_REG (Pmode,
+							  GP_REG_FIRST +
+							  MB_ABI_SUB_RETURN_ADDR_REGNUM)));
       return;
     }
 
+  /* Record the restores and the CFA changes in the CFI.  A sibling call
+     epilogue must: shrink-wrapping can leave a path without a frame and
+     cross-jumping can merge it into the sibling call, where the CFI
+     state of both must agree.  The normal epilogue must too, as
+     cfgcleanup can hoist an insn common to both epilogues above the
+     branch between them, and the hoisted insn keeps the notes of one.  */
   if (fsiz > 0)
     {
       /* Restore SUB_RETURN_ADDR_REGNUM at first. This is to prevent the
@@ -3265,7 +3309,9 @@ microblaze_expand_epilogue (void)
 	    /* Do not optimize in flow analysis.  */
 	    MEM_VOLATILE_P (mem_rtx) = 1;
 	  reg_rtx = gen_rtx_REG (SImode, MB_ABI_SUB_RETURN_ADDR_REGNUM);
-	  emit_move_insn (reg_rtx, mem_rtx);
+	  insn = emit_move_insn (reg_rtx, mem_rtx);
+	  RTX_FRAME_RELATED_P (insn) = 1;
+	  add_reg_note (insn, REG_CFA_RESTORE, reg_rtx);
 	}
 
       /* It is important that this is done after we restore the return address
@@ -3275,12 +3321,21 @@ microblaze_expand_epilogue (void)
 	 might have been over-written since alloca allocates memory on the
 	 current stack.  */
       if (frame_pointer_needed)
-	emit_insn (gen_movsi (stack_pointer_rtx, hard_frame_pointer_rtx));
+	{
+	  insn = emit_insn (gen_movsi (stack_pointer_rtx,
+				       hard_frame_pointer_rtx));
