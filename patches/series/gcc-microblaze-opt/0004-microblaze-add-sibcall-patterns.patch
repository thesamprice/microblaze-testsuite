@@ -0,0 +1,9 @@
+/* With -fPIC there are no sibling calls.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -fPIC" } */
+
+extern int g (int);
+int tail1 (int x) { return g (x + 1); }
