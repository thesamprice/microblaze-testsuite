index 000000000..57eff3a96
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/sibcall-cfi-fp.c
@@ -0,0 +1,38 @@
+/* Shrink-wrapping leaves one path to the sibling call without a frame,
+   and cross-jumping merges it into the sibling call epilogue of another
+   path.  The epilogue must record its restores and its CFA changes, or
+   the CFI state differs where the paths join.  Here the epilogue also
+   sets sp from the frame pointer.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -g -fno-omit-frame-pointer" } */
+
+typedef __SIZE_TYPE__ size_t;
+extern char *g (char *);
+extern void *malloc (size_t);
+extern void free (void *);
+extern char *fill (char *, int);
+extern size_t strlen (const char *);
+
+char *
+f (char *buf, size_t slen)
+{
+  char *abuf;
+  size_t len;
+
+  if (slen >= 0x7fffffff)
+    return g (buf);
+  if ((abuf = malloc (slen + 1)) == 0)
+    return g (buf);
+  if (fill (abuf, slen + 1) == 0)
+    {
+      free (abuf);
+      return 0;
+    }
+  len = strlen (abuf);
+  __builtin_memcpy (buf, abuf, len);
+  buf[len] = 0;
+  free (abuf);
+  return buf;
+}
+
+/* { dg-final { scan-assembler {\tbrid\tg\n} } } */
