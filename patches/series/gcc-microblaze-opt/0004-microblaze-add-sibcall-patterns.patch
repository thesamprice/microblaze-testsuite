+(define_expand "sibcall_epilogue"
+  [(use (const_int 0))]
+  ""
+  {
+      microblaze_expand_epilogue (true);
       DONE;
   }
 )
@@ -2481,6 +2490,81 @@
   (set_attr "length"	"4")])
 
 
+;; Sibling calls.  The epilogue has restored r15, so the callee returns
+;; to this function's caller.  microblaze_function_ok_for_sibcall only
+;; accepts calls with a decl and not PIC; should the address still be in
+;; a register, it goes to r12, which the epilogue does not restore.
+
+(define_expand "sibcall"
+  [(parallel [(call (match_operand 0 "memory_operand")
+		    (match_operand 1 ""))
+	      (return)
+	      (use (reg:SI R_SR))])
+   (use (match_operand 2 ""))
+   (use (match_operand 3 ""))]
+  ""
+  {
+    rtx addr = XEXP (operands[0], 0);
+    if (GET_CODE (addr) != SYMBOL_REF)
+      {
+	rtx reg = gen_rtx_REG (Pmode, MB_ABI_SIBCALL_REGNUM);
+	emit_move_insn (reg, addr);
+	addr = reg;
+      }
+    emit_call_insn (gen_sibcall_internal (addr, operands[1]));
+    DONE;
+  }
+)
+
+(define_insn "sibcall_internal"
+  [(call (mem (match_operand:SI 0 "sibcall_insn_operand" "s,d"))
+	 (match_operand 1 "" ""))
+   (return)
+   (use (reg:SI R_SR))]
+  ""
+  "@
+   brid\t%0\;%#
+   brad\t%0\;%#"
+  [(set_attr "type"	"call")
+   (set_attr "mode"	"none")
+   (set_attr "length"	"4")])
+
+(define_expand "sibcall_value"
+  [(parallel [(set (match_operand 0 "register_operand")
+		   (call (match_operand 1 "memory_operand")
+			 (match_operand 2 "")))
+	      (return)
+	      (use (reg:SI R_SR))])
+   (use (match_operand 3 ""))]
+  ""
+  {
+    rtx addr = XEXP (operands[1], 0);
+    if (GET_CODE (addr) != SYMBOL_REF)
+      {
+	rtx reg = gen_rtx_REG (Pmode, MB_ABI_SIBCALL_REGNUM);
+	emit_move_insn (reg, addr);
+	addr = reg;
+      }
+    emit_call_insn (gen_sibcall_value_internal (operands[0], addr,
+						operands[2]));
+    DONE;
+  }
+)
+
+(define_insn "sibcall_value_internal"
+  [(set (match_operand 0 "register_operand" "")
+	(call (mem (match_operand:SI 1 "sibcall_insn_operand" "s,d"))
+	      (match_operand 2 "" "")))
+   (return)
+   (use (reg:SI R_SR))]
+  ""
+  "@
+   brid\t%1\;%#
+   brad\t%1\;%#"
+  [(set_attr "type"	"call")
+   (set_attr "mode"	"none")
+   (set_attr "length"	"4")])
+
