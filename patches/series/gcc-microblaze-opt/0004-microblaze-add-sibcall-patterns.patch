diff --git a/gcc/testsuite/gcc.target/microblaze/isa/sibcall.c b/gcc/testsuite/gcc.target/microblaze/isa/sibcall.c
new file mode 100644
index 000000000..127c53a89
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/isa/sibcall.c
@@ -0,0 +1,22 @@
+/* Calls in tail position become branches, except where the callee
+   needs more stack arguments than the caller has, or the caller is an
+   interrupt handler.  */
+/* { dg-options "-O2" } */
+
+extern int g (int);
+extern int g7 (int, int, int, int, int, int, int);
+extern void h (void);
+
+int tail1 (int x) { return g (x + 1); }		/* brid g */
+int tail7 (int a, int b, int c, int d, int e, int f, int s)
+{ return g7 (f, e, d, c, b, a, s); }		/* brid g7 */
+int more_args (int a, int b, int c, int d, int e, int f)
+{ return g7 (a, b, c, d, e, f, 1); }		/* brlid g7 */
+void __attribute__ ((interrupt_handler)) isr (void) { h (); }	/* brlid h */
+void __attribute__ ((save_volatiles)) savev (void) { h (); }	/* brlid h */
+
+/* { dg-final { scan-assembler {\tbrid\tg\n} } } */
+/* { dg-final { scan-assembler-times {\tbrid\tg7\n} 1 } } */
+/* { dg-final { scan-assembler-times {\tbrlid\tr15,g7\n} 1 } } */
+/* { dg-final { scan-assembler-times {\tbrlid\tr15,h\n} 2 } } */
+/* { dg-final { scan-assembler-not {\tbrid\th\n} } } */
