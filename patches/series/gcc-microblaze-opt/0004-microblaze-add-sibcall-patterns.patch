diff --git a/gcc/testsuite/gcc.target/microblaze/others/sibcall-run.c b/gcc/testsuite/gcc.target/microblaze/others/sibcall-run.c
new file mode 100644
index 000000000..51189a039
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/sibcall-run.c
@@ -0,0 +1,124 @@
+/* Check sibling calls: tail recursion, mutual recursion, arguments on
+   the stack, a callee that needs more stack arguments than its caller,
+   a variadic callee, a struct returned in memory, and an indirect call
+   through a pointer the compiler knows.  */
+/* { dg-do run } */
+
+#include <stdarg.h>
+
+extern void abort (void);
+
+__attribute__ ((noipa)) int
+sum_to (int n, int acc)
+{
+  if (n == 0)
+    return acc;
+  return sum_to (n - 1, acc + n);
+}
+
+__attribute__ ((noipa)) int is_odd (unsigned n);
+__attribute__ ((noipa)) int
+is_even (unsigned n)
+{
+  return n == 0 ? 1 : is_odd (n - 1);
+}
+__attribute__ ((noipa)) int
+is_odd (unsigned n)
+{
+  return n == 0 ? 0 : is_even (n - 1);
+}
+
+/* Eight arguments: two on the stack.  */
+__attribute__ ((noipa)) int
+mix8 (int a, int b, int c, int d, int e, int f, int g, int h)
+{
+  return a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g + 8 * h;
+}
+
+__attribute__ ((noipa)) int
+swap8 (int a, int b, int c, int d, int e, int f, int g, int h)
+{
+  return mix8 (h, g, f, e, d, c, b, a);
+}
+
+/* Ten arguments from a function with six: no sibling call.  */
+__attribute__ ((noipa)) int
+mix10 (int a, int b, int c, int d, int e, int f, int g, int h, int i, int j)
+{
+  return mix8 (a, b, c, d, e, f, g, h) + 9 * i + 10 * j;
+}
+
+__attribute__ ((noipa)) int
+grow (int a, int b, int c, int d, int e, int f)
+{
+  return mix10 (f, e, d, c, b, a, a, b, c, d);
+}
+
+__attribute__ ((noipa)) int
+vsum (int n, ...)
+{
+  va_list ap;
+  int s = 0;
+  va_start (ap, n);
+  while (n--)
+    s += va_arg (ap, int);
+  va_end (ap);
+  return s;
+}
+
+__attribute__ ((noipa)) int
+call_vsum (int a, int b)
+{
+  return vsum (3, a, b, a + b);
+}
+
+struct big { int v[5]; };
+
+__attribute__ ((noipa)) struct big
+make_big (int x)
+{
+  struct big b = { { x, x + 1, x + 2, x + 3, x + 4 } };
+  return b;
+}
+
+__attribute__ ((noipa)) struct big
+pass_big (int x)
+{
+  return make_big (x * 2);
+}
+
+__attribute__ ((noipa)) long long
+add64 (long long a, long long b)
+{
+  return a + b;
+}
+
+__attribute__ ((noipa)) long long
+call_add64 (int a, long long b)
+{
+  return add64 (b, a);
+}
+
+int
+main (void)
+{
+  struct big b;
+
+  if (sum_to (10000, 0) != 50005000)
+    abort ();
+  if (!is_even (10000) || is_odd (10000) || !is_odd (9999))
+    abort ();
+  if (swap8 (1, 2, 3, 4, 5, 6, 7, 8) != mix8 (8, 7, 6, 5, 4, 3, 2, 1))
+    abort ();
+  if (grow (1, 2, 3, 4, 5, 6)
+      != mix8 (6, 5, 4, 3, 2, 1, 1, 2) + 9 * 3 + 10 * 4)
+    abort ();
+  if (call_vsum (5, 7) != 24)
+    abort ();
+  b = pass_big (10);
+  if (b.v[0] != 20 || b.v[4] != 24)
+    abort ();
+  if (call_add64 (-1, 0x100000000LL) != 0xffffffffLL)
+    abort ();
+  return 0;
+}
