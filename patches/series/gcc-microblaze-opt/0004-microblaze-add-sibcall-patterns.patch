+/* Implement TARGET_FUNCTION_OK_FOR_SIBCALL.  A sibling call restores
+   the caller's frame and branches to the callee, which returns to the
+   caller's caller through r15.  */
+
+static bool
+microblaze_function_ok_for_sibcall (tree decl, tree exp ATTRIBUTE_UNUSED)
+{
+  /* Indirect calls would need a register that the epilogue keeps.  */
+  if (!decl)
+    return false;
+
+  /* PLT calls and the GOT pointer are not worth the trouble.  */
+  if (flag_pic)
+    return false;
+
+  /* Interrupt and break handlers return with rtid or rtbd, and
+     save_volatiles functions must restore the volatile registers after
+     the callee has run.  */
+  if (microblaze_interrupt_function_p (current_function_decl)
+      || microblaze_fast_interrupt_function_p (current_function_decl)
+      || microblaze_break_function_p (current_function_decl)
+      || microblaze_save_volatiles (current_function_decl))
+    return false;
+
+  /* Nor branch to one: a break handler is entered with brki, and an
+     interrupt handler expects to be entered by an interrupt.  */
+  if (microblaze_interrupt_function_p (decl)
+      || microblaze_fast_interrupt_function_p (decl)
+      || microblaze_break_function_p (decl))
+    return false;
+
+  return true;
+}
+
