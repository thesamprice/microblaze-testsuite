 /* { dg-final { scan-tree-dump "versioned this loop for when certain strides are 1" "lversion" } } */
+/* { dg-additional-options "-gas-loc-support" { target gas } } */
 /* { dg-final { scan-assembler "\\.loc 1 (9|10) \[0-9\]+ is_stmt 0 discriminator (\[1-9\]\[0-9\]*|0x\[1-9a-fA-F\]\[0-9a-fA-F\]*)" { target gas } } } */
diff --git a/gcc/testsuite/gcc.dg/hierarchical-discriminator-rtl-unroll.c b/gcc/testsuite/gcc.dg/hierarchical-discriminator-rtl-unroll.c
index ff771224e..0879031c3 100644
--- a/gcc/testsuite/gcc.dg/hierarchical-discriminator-rtl-unroll.c
+++ b/gcc/testsuite/gcc.dg/hierarchical-discriminator-rtl-unroll.c
@@ -18,4 +18,5 @@ test_rtl_unroll (void)
 
 /* RTL unroll via loop-unroll.cc should assign non-zero copyid
    discriminators via copy_bbs.  */
+/* { dg-additional-options "-gas-loc-support" { target gas } } */
 /* { dg-final { scan-assembler "discriminator (\[1-9\]\[0-9\]*|0x\[1-9a-fA-F\]\[0-9a-fA-F\]*)" { target gas } } } */
diff --git a/gcc/testsuite/gcc.dg/hierarchical-discriminator-tracer.c b/gcc/testsuite/gcc.dg/hierarchical-discriminator-tracer.c
index 84b804cd7..a6f56b274 100644
--- a/gcc/testsuite/gcc.dg/hierarchical-discriminator-tracer.c
+++ b/gcc/testsuite/gcc.dg/hierarchical-discriminator-tracer.c
@@ -21,4 +21,5 @@ test_tracer (void)
 
 /* Superblock formation duplicates the increment of c.  */
 /* { dg-final { scan-tree-dump "Duplicated" "tracer" } } */
+/* { dg-additional-options "-gas-loc-support" { target gas } } */
 /* { dg-final { scan-assembler "discriminator (\[1-9\]\[0-9\]*|0x\[1-9a-fA-F\]\[0-9a-fA-F\]*)" { target gas } } } */
diff --git a/gcc/testsuite/gcc.dg/hierarchical-discriminator-unroll-jam.c b/gcc/testsuite/gcc.dg/hierarchical-discriminator-unroll-jam.c
index bdea95b94..cd14e6126 100644
--- a/gcc/testsuite/gcc.dg/hierarchical-discriminator-unroll-jam.c
+++ b/gcc/testsuite/gcc.dg/hierarchical-discriminator-unroll-jam.c
@@ -16,4 +16,5 @@ test_unroll_jam (unsigned long n, unsigned long m)
 }
 
 /* { dg-final { scan-tree-dump "applying unroll and jam" "unrolljam" } } */
+/* { dg-additional-options "-gas-loc-support" { target gas } } */
 /* { dg-final { scan-assembler "discriminator (\[1-9\]\[0-9\]*|0x\[1-9a-fA-F\]\[0-9a-fA-F\]*)" { target gas } } } */
diff --git a/gcc/testsuite/gcc.dg/hierarchical-discriminator-unroll.c b/gcc/testsuite/gcc.dg/hierarchical-discriminator-unroll.c
index ed8cb0c24..38e654bae 100644
--- a/gcc/testsuite/gcc.dg/hierarchical-discriminator-unroll.c
+++ b/gcc/testsuite/gcc.dg/hierarchical-discriminator-unroll.c
@@ -27,4 +27,5 @@ test_unroll (void)
    The exact values depend on what other passes have run, but all should be non-zero. */
 
 /* Check that unrolled iterations have non-zero discriminators on the asm statement line. */
+/* { dg-additional-options "-gas-loc-support" { target gas } } */
 /* { dg-final { scan-assembler "\\.loc 1 17 7 is_stmt 0 discriminator (\[1-9\]\[0-9\]*|0x\[1-9a-fA-F\]\[0-9a-fA-F\]*)" { target gas } } } */
diff --git a/gcc/testsuite/gcc.dg/hierarchical-discriminator-unswitch.c b/gcc/testsuite/gcc.dg/hierarchical-discriminator-unswitch.c
