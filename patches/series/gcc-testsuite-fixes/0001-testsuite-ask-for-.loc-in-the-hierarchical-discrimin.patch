+++ b/gcc/testsuite/gcc.dg/hierarchical-discriminator-unswitch.c
@@ -19,4 +19,5 @@ test_unswitch (int *a, int *b, int *r, int size, int order)
 }
 
 /* { dg-final { scan-tree-dump "unswitching loop" "unswitch" } } */
+/* { dg-additional-options "-gas-loc-support" { target gas } } */
 /* { dg-final { scan-assembler "discriminator (\[1-9\]\[0-9\]*|0x\[1-9a-fA-F\]\[0-9a-fA-F\]*)" { target gas } } } */
