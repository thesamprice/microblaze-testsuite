From 4d70570924f92cea2b08f72f63e1647ca4618fd3 Mon Sep 17 00:00:00 2001
From: Samuel Price <thesamprice@gmail.com>
Date: Thu, 12 Nov 2026 18:16:41 -0500
Subject: [PATCH 1/4] microblaze: remove the fint-and-branch peephole2

microblaze.md has a define_peephole2 that matches a fix:SI followed by
a conditional branch and replaces the pair with a cstoresf4 and a jump.
It emits the jump_insn from a peephole2, so the jump lands inside a
basic block and the RTL verifier stops with "flow control insn inside a
basic block".  It also drops the fix:SI, so operand 0 is never set, and
it compares the branch operands as SFmode registers; when the second
operand is a constant, as in "k < 0", it applies REGNO to a CONST_INT.

	int f (float a) { int k = (int) a; if (k < 0) return 1; return 2; }

ICEs at -O2 with -mhard-float -mxl-float-convert.  With -fno-checking,
or a compiler configured with release checking, it is wrong code
instead: the fint is gone and the branch tests a < 0.0, so f (-0.5f)
returns 1.

There is no equivalent transformation to keep: (int) a < 0 and a < 0
differ for -1 < a < 0.  Remove the pattern.

The pattern came in with 0bb87e8a83d3 (SVN r222790, 2015) to avoid the
latency of fint.  If that is worth having, the place for it is match.pd,
not a peephole2: the conversion truncates toward zero, so for an integer C
that is exact in the float type, (int) a < C is a <= C - 1 when C <= 0
and a < C when C > 0.  As a gimple folding it would apply to every
target, and before register allocation, where the new constant is not
a problem.

Assisted-by: Claude <noreply@anthropic.com>

gcc/ChangeLog:

	* config/microblaze/microblaze.md: Remove the peephole2 that
	combined fix:SI with a conditional branch.

gcc/testsuite/ChangeLog:

	* gcc.target/microblaze/others/fint-branch.c: New test.
---
 gcc/config/microblaze/microblaze.md           | 26 ----------------
 .../microblaze/others/fint-branch.c           | 31 +++++++++++++++++++
 2 files changed, 31 insertions(+), 26 deletions(-)
 create mode 100644 gcc/testsuite/gcc.target/microblaze/others/fint-branch.c

diff --git a/gcc/config/microblaze/microblaze.md b/gcc/config/microblaze/microblaze.md
index 906d4572d..d715c963c 100644
--- a/gcc/config/microblaze/microblaze.md
+++ b/gcc/config/microblaze/microblaze.md
@@ -690,32 +690,6 @@
   (set_attr "mode"	"SI")
   (set_attr "length"	"4")])
 
-(define_peephole2
-  [(set (match_operand:SI 0 "register_operand")
-        (fix:SI (match_operand:SF 1 "register_operand")))
-   (set (pc)
-        (if_then_else (match_operator 2 "ordered_comparison_operator"
-                       [(match_operand:SI 3 "register_operand")
-                        (match_operand:SI 4 "arith_operand")])
-                      (label_ref (match_operand 5))
-                      (pc)))]
-   "TARGET_HARD_FLOAT"
-   [(set (match_dup 1) (match_dup 3))]
-
-  {
-    rtx condition;
-    rtx cmp_op0 = operands[3];
-    rtx cmp_op1 = operands[4];
-    rtx comp_reg =  gen_rtx_REG (SImode, MB_ABI_ASM_TEMP_REGNUM);
-
-    emit_insn (gen_cstoresf4 (comp_reg, operands[2],
-                              gen_rtx_REG (SFmode, REGNO (cmp_op0)),
-                              gen_rtx_REG (SFmode, REGNO (cmp_op1))));
-    condition = gen_rtx_NE (SImode, comp_reg, const0_rtx);
-    emit_jump_insn (gen_condjump (condition, operands[5]));
-  }
-)
-
 ;;----------------------------------------------------------------
 ;; Negation and one's complement
 ;;----------------------------------------------------------------
diff --git a/gcc/testsuite/gcc.target/microblaze/others/fint-branch.c b/gcc/testsuite/gcc.target/microblaze/others/fint-branch.c
new file mode 100644
index 000000000..fe8690aac
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/fint-branch.c
@@ -0,0 +1,31 @@
+/* { dg-do run } */
+/* { dg-options "-mhard-float -mxl-float-convert" } */
+
+/* A fint whose result is only tested for its sign.  A peephole2 used to
+   replace the pair with an fcmp of the float against 0.0 and a jump.
+   With checking that ICEd with "flow control insn inside a basic block";
+   without it the fint was dropped, so -0.5f, which converts to 0, took
+   the k < 0 branch.  */
+
+extern void abort (void);
+
+__attribute__ ((noipa)) int
+f (float a)
+{
+  int k = (int) a;
+  if (k < 0)
+    return 1;
+  return 2;
+}
+
+int
+main (void)
+{
+  if (f (-0.5f) != 2)
+    abort ();
+  if (f (-1.5f) != 1)
+    abort ();
+  if (f (0.5f) != 2)
+    abort ();
+  return 0;
+}
