+++ b/opcodes/microblaze-dis.c
@@ -239,6 +239,21 @@ read_insn_microblaze (bfd_vma memaddr,
 }
 
 
+/* Return the 32-bit value of the immediate operand of INST, extended by
+   the IMM prefix IMMVAL if IMMFOUND.  */
+
+static bfd_vma
+get_imm_value (unsigned long inst, bool immfound, int immval)
+{
+  uint32_t val = get_int_field_imm (inst) & 0xffff;
+
+  if (immfound)
+    val |= (uint32_t) immval & 0xffff0000;
+  else if (val & 0x8000)
+    val |= 0xffff0000;
+  return val;
+}
