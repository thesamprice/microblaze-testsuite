diff --git a/ld/testsuite/ld-microblaze/disas-high.s b/ld/testsuite/ld-microblaze/disas-high.s
new file mode 100644
index 00000000000..8c5dada5683
--- /dev/null
+++ b/ld/testsuite/ld-microblaze/disas-high.s
@@ -0,0 +1,21 @@
+/* The disassembler names the targets of a call, a branch and an
+   address load at or above 0x80000000.  */
+
+	.text
+	.globl	_start
+_start:
+	brlid	r15, far
+	nop
+	addik	r3, r0, dat
+	bri	_start
+	brai	_start
+
+	.section .text.far,"ax"
+far:
+	rtsd	r15, 8
+	nop
+
+	.data
+	.word	0
+dat:
+	.word	0
