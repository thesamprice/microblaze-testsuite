diff --git a/gas/testsuite/gas/microblaze/reg-err.l b/gas/testsuite/gas/microblaze/reg-err.l
new file mode 100644
index 00000000000..bb9ed7ed288
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/reg-err.l
@@ -0,0 +1,6 @@
+.*: Assembler messages:
+.*:4: Error: Invalid register number at 'r100'
+.*:5: Error: Invalid register number at 'r32'
+.*:6: Error: Invalid register number at 'rfsl10'
+.*:7: Error: Invalid register number at 'rpvr12'
+.*:8: Error: Invalid register number at 'r99999'
diff --git a/gas/testsuite/gas/microblaze/reg-err.s b/gas/testsuite/gas/microblaze/reg-err.s
new file mode 100644
index 00000000000..374c95f4eea
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/reg-err.s
@@ -0,0 +1,8 @@
+# A register number is all of its digits.  r100 was read as r10.
+
+	.text
+	add	r3, r4, r100
+	add	r3, r031, r32
+	get	r3, rfsl100
+	mfs	r3, rpvr120
+	add	r3, r4, r99999999999
