From 4c5d2192cf14223ce28bd7a4f15852a67dc69101 Mon Sep 17 00:00:00 2001
From: Samuel Price <thesamprice@gmail.com>
Date: Sun, 15 Nov 2026 01:14:23 -0500
Subject: [PATCH 4/9] gas: microblaze: reject @TLSTPREL and @TLSDTPMOD operands

parse_imm accepts the @TLSTPREL and @TLSDTPMOD suffixes and gives the
frag the TLSTPREL_OFFSET or TLSDTPMOD_OFFSET subtype, but
md_convert_frag has no case for either and aborts:

	addik r3, r0, x@TLSTPREL
	-> Internal error in md_convert_frag at tc-microblaze.c:2038

Adding the cases would produce R_MICROBLAZE_TLSTPREL32 and
R_MICROBLAZE_TLSDTPMOD32 in code, which no tool can use:
microblaze_elf_relocate_section implements neither the initial-exec
nor the local-exec TLS model, and TLSDTPMOD32 is the dynamic
relocation for the module ID in a GOT entry, not an instruction
operand.  GCC never emits either suffix (it uses @TLSGD, @TLSLDM and
@TLSDTPREL).  Report an error instead.  The cases can be added along
with linker support for the IE and LE models.

gas/
	* config/tc-microblaze.c (parse_imm): Reject @TLSTPREL and
	@TLSDTPMOD.
	* testsuite/gas/microblaze/tls-err.d: New test.
	* testsuite/gas/microblaze/tls-err.l: New file.
	* testsuite/gas/microblaze/tls-err.s: New file.
	* testsuite/gas/microblaze/errors.exp: Run it.

Assisted-by: Claude <noreply@anthropic.com>
---
 gas/config/tc-microblaze.c              | 9 +++++++++
 gas/testsuite/gas/microblaze/errors.exp | 1 +
 gas/testsuite/gas/microblaze/tls-err.d  | 4 ++++
 gas/testsuite/gas/microblaze/tls-err.l  | 3 +++
 gas/testsuite/gas/microblaze/tls-err.s  | 9 +++++++++
 5 files changed, 26 insertions(+)
 create mode 100644 gas/testsuite/gas/microblaze/tls-err.d
 create mode 100644 gas/testsuite/gas/microblaze/tls-err.l
 create mode 100644 gas/testsuite/gas/microblaze/tls-err.s

diff --git a/gas/config/tc-microblaze.c b/gas/config/tc-microblaze.c
index 31545517f84..e70d5dfbd4c 100644
--- a/gas/config/tc-microblaze.c
+++ b/gas/config/tc-microblaze.c
@@ -715,6 +715,15 @@ parse_imm (char * s, expressionS * e, offsetT min, offsetT max)
         {
           *atp = 0;
           e->X_md = itype;
+	  /* The linker does not implement the initial-exec and
+	     local-exec TLS models, and a module ID belongs in a GOT
+	     entry, not in an instruction.  */
+	  if (itype == IMM_TLSTPREL || itype == IMM_TLSDTPMOD)
+	    {
+	      as_bad (_("@%s is not supported in an instruction"),
+		      itype == IMM_TLSTPREL ? "TLSTPREL" : "TLSDTPMOD");
+	      e->X_md = 0;
+	    }
         }
       else
         {
diff --git a/gas/testsuite/gas/microblaze/errors.exp b/gas/testsuite/gas/microblaze/errors.exp
index 0ad8efd06db..7404198d64e 100644
--- a/gas/testsuite/gas/microblaze/errors.exp
+++ b/gas/testsuite/gas/microblaze/errors.exp
@@ -4,4 +4,5 @@ if [istarget microblaze*-*-*] {
     run_dump_test "imm-sym-err"
     run_dump_test "imm-range-err"
     run_dump_test "imm-range"
+    run_dump_test "tls-err"
 }
diff --git a/gas/testsuite/gas/microblaze/tls-err.d b/gas/testsuite/gas/microblaze/tls-err.d
new file mode 100644
index 00000000000..33857d46ea0
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/tls-err.d
@@ -0,0 +1,4 @@
+#as:
+#source: tls-err.s
+#error_output: tls-err.l
+#name: MicroBlaze unsupported TLS operators
diff --git a/gas/testsuite/gas/microblaze/tls-err.l b/gas/testsuite/gas/microblaze/tls-err.l
new file mode 100644
index 00000000000..3156d590309
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/tls-err.l
@@ -0,0 +1,3 @@
+.*: Assembler messages:
+.*:5: Error: @TLSTPREL is not supported in an instruction
+.*:6: Error: @TLSDTPMOD is not supported in an instruction
diff --git a/gas/testsuite/gas/microblaze/tls-err.s b/gas/testsuite/gas/microblaze/tls-err.s
new file mode 100644
index 00000000000..06164af1b1d
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/tls-err.s
@@ -0,0 +1,9 @@
+# The initial-exec and local-exec TLS models are not implemented, and a
+# module ID cannot be an instruction operand.
+
+	.text
+	addik	r3, r0, x@TLSTPREL
+	addik	r3, r0, x@TLSDTPMOD
+	addik	r3, r0, x@TLSGD
+	addik	r3, r0, x@TLSLDM
+	addik	r3, r0, x@TLSDTPREL
