From 327283817c093e091d84efa5fcc286d59529cdff Mon Sep 17 00:00:00 2001
From: Samuel Price <thesamprice@gmail.com>
Date: Sun, 15 Nov 2026 01:27:16 -0500
Subject: [PATCH 8/9] gas: microblaze: fix @GOTOFF in .word

check_got looks for an "@" up to the end of the statement, so in

	.word a, b@GOTOFF

the first operand found b's suffix, was parsed from a copy with the
suffix removed, and left input_line_pointer in the wrong place: "junk
at end of line, first unrecognized character is `O'".  And
cons_fix_new_microblaze used R_MICROBLAZE_GOTOFF_32 only for .gpword,
so ".word b@GOTOFF" got a plain R_MICROBLAZE_32 against b.  @GOT and
@PLT, which have no data relocation, were dropped the same way.

Stop the scan at a comma, as 67c11a9b99d did for i386.  Have
parse_cons_expression_microblaze return BFD_RELOC_MICROBLAZE_32_GOTOFF
for @GOTOFF, which emit_expr passes to cons_fix_new_microblaze, rather
than relying on X_md and O_symbol_rva, and report @GOT and @PLT in
data as errors.

gas/
	* config/tc-microblaze.c (check_got): Stop at a comma.
	(parse_cons_expression_microblaze): Return
	BFD_RELOC_MICROBLAZE_32_GOTOFF for @GOTOFF and reject @GOT and
	@PLT.
	(cons_fix_new_microblaze): Use the relocation it returned.
	* testsuite/gas/microblaze/gotoff-data.exp: New file.
	* testsuite/gas/microblaze/gotoff-data.d: New test.
	* testsuite/gas/microblaze/gotoff-data.s: New file.
	* testsuite/gas/microblaze/got-data-err.d: New test.
	* testsuite/gas/microblaze/got-data-err.l: New file.
	* testsuite/gas/microblaze/got-data-err.s: New file.
	* testsuite/gas/microblaze/errors.exp: Run got-data-err.

Assisted-by: Claude <noreply@anthropic.com>
---
 gas/config/tc-microblaze.c                   | 21 ++++++++++++--------
 gas/testsuite/gas/microblaze/errors.exp      |  1 +
 gas/testsuite/gas/microblaze/got-data-err.d  |  4 ++++
 gas/testsuite/gas/microblaze/got-data-err.l  |  3 +++
 gas/testsuite/gas/microblaze/got-data-err.s  |  5 +++++
 gas/testsuite/gas/microblaze/gotoff-data.d   | 15 ++++++++++++++
 gas/testsuite/gas/microblaze/gotoff-data.exp |  5 +++++
 gas/testsuite/gas/microblaze/gotoff-data.s   | 10 ++++++++++
 8 files changed, 56 insertions(+), 8 deletions(-)
 create mode 100644 gas/testsuite/gas/microblaze/got-data-err.d
 create mode 100644 gas/testsuite/gas/microblaze/got-data-err.l
 create mode 100644 gas/testsuite/gas/microblaze/got-data-err.s
 create mode 100644 gas/testsuite/gas/microblaze/gotoff-data.d
 create mode 100644 gas/testsuite/gas/microblaze/gotoff-data.exp
 create mode 100644 gas/testsuite/gas/microblaze/gotoff-data.s

diff --git a/gas/config/tc-microblaze.c b/gas/config/tc-microblaze.c
index 603a322dbe5..3040e164913 100644
--- a/gas/config/tc-microblaze.c
+++ b/gas/config/tc-microblaze.c
@@ -793,9 +793,10 @@ check_got (int * got_type, int * got_len)
   int first, second;
   char *tmpbuf;
 
-  /* Find the start of "@GOT" or "@PLT" suffix (if any).  */
+  /* Find the start of "@GOT" or "@PLT" suffix (if any), in this
+     operand only.  */
   for (atp = input_line_pointer; *atp != '@'; atp++)
-    if (is_end_of_stmt (*atp))
+    if (is_end_of_stmt (*atp) || *atp == ',')
       return NULL;
 
   if (startswith (atp + 1, "GOTOFF"))
@@ -857,7 +858,13 @@ parse_cons_expression_microblaze (expressionS *exp, int size)
           input_line_pointer = save + (input_line_pointer - gotfree_copy)
 	    + got_len;
           free (gotfree_copy);
-        }
+
+	  /* Only @GOTOFF has a data relocation.  */
+	  if (got_type == IMM_GOTOFF)
+	    return BFD_RELOC_MICROBLAZE_32_GOTOFF;
+	  as_bad (_("@%s is not supported in data"),
+		  got_type == IMM_GOT ? "GOT" : "PLT");
+	}
     }
   else
     expression (exp);
@@ -2933,11 +2940,9 @@ cons_fix_new_microblaze (fragS * frag,
   /* A difference of two symbols needs nothing special: fixup_segment
      resolves it, or md_apply_fix turns it into an ADD and SUB pair.
      R_MICROBLAZE_32_SYM_OP_SYM, which the linker ignores, is not used.  */
-  if (exp->X_md == IMM_GOTOFF && exp->X_op == O_symbol_rva)
-    {
-      exp->X_op = O_symbol;
-      r = BFD_RELOC_MICROBLAZE_32_GOTOFF;
-    }
+  if (r == BFD_RELOC_MICROBLAZE_32_GOTOFF)
+    /* From parse_cons_expression_microblaze, for .word or .gpword.  */
+    exp->X_op = O_symbol;
   else
     {
       switch (size)
diff --git a/gas/testsuite/gas/microblaze/errors.exp b/gas/testsuite/gas/microblaze/errors.exp
index 58dcac5d20b..35ae978ae6a 100644
--- a/gas/testsuite/gas/microblaze/errors.exp
+++ b/gas/testsuite/gas/microblaze/errors.exp
@@ -8,4 +8,5 @@ if [istarget microblaze*-*-*] {
     run_dump_test "suffix-err"
     run_dump_test "reg-err"
     run_dump_test "data8-err"
+    run_dump_test "got-data-err"
 }
diff --git a/gas/testsuite/gas/microblaze/got-data-err.d b/gas/testsuite/gas/microblaze/got-data-err.d
new file mode 100644
index 00000000000..4dae1b23d1f
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/got-data-err.d
@@ -0,0 +1,4 @@
+#as:
+#source: got-data-err.s
+#error_output: got-data-err.l
+#name: MicroBlaze @GOT and @PLT in data
diff --git a/gas/testsuite/gas/microblaze/got-data-err.l b/gas/testsuite/gas/microblaze/got-data-err.l
new file mode 100644
index 00000000000..60a44706e93
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/got-data-err.l
@@ -0,0 +1,3 @@
+.*: Assembler messages:
+.*:4: Error: @GOT is not supported in data
+.*:5: Error: @PLT is not supported in data
diff --git a/gas/testsuite/gas/microblaze/got-data-err.s b/gas/testsuite/gas/microblaze/got-data-err.s
new file mode 100644
index 00000000000..7dd1cf6616b
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/got-data-err.s
@@ -0,0 +1,5 @@
+# There is no data relocation for @GOT or @PLT.  They were dropped.
+
+	.data
+	.word	a@GOT
+	.word	b, c@PLT
diff --git a/gas/testsuite/gas/microblaze/gotoff-data.d b/gas/testsuite/gas/microblaze/gotoff-data.d
new file mode 100644
index 00000000000..13f31f06f0e
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/gotoff-data.d
@@ -0,0 +1,15 @@
+#objdump: -r
+#name: MicroBlaze @GOTOFF in data
+#source: gotoff-data.s
+
+.*: +file format .*
+
+RELOCATION RECORDS FOR \[\.data\]:
+OFFSET +TYPE +VALUE
+0+0000 R_MICROBLAZE_32 +a
+0+0004 R_MICROBLAZE_GOTOFF_32 +b
+0+0008 R_MICROBLAZE_GOTOFF_32 +b
+0+000c R_MICROBLAZE_32 +a
+0+0010 R_MICROBLAZE_GOTOFF_32 +b
+0+0014 R_MICROBLAZE_GOTOFF_32 +c
+0+0018 R_MICROBLAZE_GOTOFF_32 +d\+0x0+4
diff --git a/gas/testsuite/gas/microblaze/gotoff-data.exp b/gas/testsuite/gas/microblaze/gotoff-data.exp
new file mode 100644
index 00000000000..80098bc9138
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/gotoff-data.exp
@@ -0,0 +1,5 @@
+# Relocation suffixes in MicroBlaze data.
+
+if [istarget microblaze*-*-*] {
+    run_dump_test "gotoff-data"
+}
diff --git a/gas/testsuite/gas/microblaze/gotoff-data.s b/gas/testsuite/gas/microblaze/gotoff-data.s
new file mode 100644
index 00000000000..fb0110c523d
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/gotoff-data.s
@@ -0,0 +1,10 @@
+# @GOTOFF in .word and .gpword.  The suffix applies to its own operand:
+# the first line was "junk at end of line", and the others were plain
+# R_MICROBLAZE_32 relocations.
+
+	.data
+	.word	a, b@GOTOFF
+	.word	b@GOTOFF, a
+	.word	b@GOTOFF
+	.gpword	c@GOTOFF
+	.word	d@GOTOFF + 4
