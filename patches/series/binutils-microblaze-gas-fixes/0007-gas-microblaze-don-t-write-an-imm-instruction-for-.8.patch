diff --git a/gas/testsuite/gas/microblaze/data8-err.l b/gas/testsuite/gas/microblaze/data8-err.l
new file mode 100644
index 00000000000..99ff9979129
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/data8-err.l
@@ -0,0 +1,3 @@
+.*: Assembler messages:
+.*:5: Error: cannot represent a 64-bit data relocation
+.*:6: Error: cannot represent a 64-bit data relocation
diff --git a/gas/testsuite/gas/microblaze/data8-err.s b/gas/testsuite/gas/microblaze/data8-err.s
new file mode 100644
index 00000000000..8e76b7672ed
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/data8-err.s
@@ -0,0 +1,6 @@
+# There is no 64-bit data relocation.  .8byte foo wrote an IMM opcode
+# and an R_MICROBLAZE_64 relocation into .data.
+
+	.data
+	.8byte	foo
+	.8byte	foo + 4
diff --git a/gas/testsuite/gas/microblaze/data8.d b/gas/testsuite/gas/microblaze/data8.d
new file mode 100644
index 00000000000..bbc005784f4
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/data8.d
@@ -0,0 +1,11 @@
+#as: -EB
+#objdump: -rs -j .data
+#name: MicroBlaze .8byte
+#source: data8.s
+
+.*: +file format .*
+
+Contents of section \.data:
+ 0000 00000001 00000000 00000014 ffffffff  .*
+ 0010 ffffffec 12345678 9abcdef0 ffffffff  .*
+ 0020 fffffffe +.*
diff --git a/gas/testsuite/gas/microblaze/data8.exp b/gas/testsuite/gas/microblaze/data8.exp
new file mode 100644
index 00000000000..e571d3a0c48
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/data8.exp
@@ -0,0 +1,6 @@
+# Eight-byte data on MicroBlaze.
+
+if [istarget microblaze*-*-*] {
+    run_dump_test "data8"
+    run_dump_test "data8-el"
+}
diff --git a/gas/testsuite/gas/microblaze/data8.s b/gas/testsuite/gas/microblaze/data8.s
new file mode 100644
index 00000000000..655a8ab036c
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/data8.s
@@ -0,0 +1,9 @@
+# .8byte writes eight bytes of data.  A difference resolved by the
+# assembler got an IMM opcode in its first word.
+
+	.data
+a:	.4byte	1
+	.8byte	b - a
+	.8byte	a - b
+b:	.8byte	0x123456789abcdef0
+	.8byte	-2
diff --git a/gas/testsuite/gas/microblaze/errors.exp b/gas/testsuite/gas/microblaze/errors.exp
index 1dd68b14b24..58dcac5d20b 100644
--- a/gas/testsuite/gas/microblaze/errors.exp
+++ b/gas/testsuite/gas/microblaze/errors.exp
@@ -7,4 +7,5 @@ if [istarget microblaze*-*-*] {
     run_dump_test "tls-err"
     run_dump_test "suffix-err"
     run_dump_test "reg-err"
+    run_dump_test "data8-err"
 }
