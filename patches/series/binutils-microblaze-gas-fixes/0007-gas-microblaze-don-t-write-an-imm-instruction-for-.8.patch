From 6b8684571cb9ac3c6e40c39aabe08efa61a0ede7 Mon Sep 17 00:00:00 2001
From: Samuel Price <thesamprice@gmail.com>
Date: Sun, 15 Nov 2026 01:23:10 -0500
Subject: [PATCH 7/9] gas: microblaze: don't write an imm instruction for
 .8byte

cons_fix_new_microblaze gives eight bytes of data BFD_RELOC_64, which
on MicroBlaze is the relocation for an IMM pair, so md_apply_fix
writes an imm opcode into the data:

	.data
	.8byte foo
	-> .data = b0000000 00000000, R_MICROBLAZE_64 foo

The same happened to a difference of data labels that fixup_segment
resolves ("b0000000 00000014" for 0x14).

Mark the fixup with fx_tcbit, and have md_apply_fix write the 8-byte
value in target byte order when it is known.  There is no 64-bit data
relocation for elf32-microblaze, so report an error when a relocation
would be needed.

gas/
	* config/tc-microblaze.c (cons_fix_new_microblaze): Set fx_tcbit
	on an 8-byte fixup.
	(md_apply_fix): Write 8 bytes of data, or report that the
	relocation cannot be represented.
	* testsuite/gas/microblaze/data8.exp: New file.
	* testsuite/gas/microblaze/data8.d: New test.
	* testsuite/gas/microblaze/data8-el.d: New test.
	* testsuite/gas/microblaze/data8.s: New file.
	* testsuite/gas/microblaze/data8-err.d: New test.
	* testsuite/gas/microblaze/data8-err.l: New file.
	* testsuite/gas/microblaze/data8-err.s: New file.
	* testsuite/gas/microblaze/errors.exp: Run data8-err.

Assisted-by: Claude <noreply@anthropic.com>
---
 gas/config/tc-microblaze.c               | 21 +++++++++++++++++++--
 gas/testsuite/gas/microblaze/data8-el.d  | 11 +++++++++++
 gas/testsuite/gas/microblaze/data8-err.d |  4 ++++
 gas/testsuite/gas/microblaze/data8-err.l |  3 +++
 gas/testsuite/gas/microblaze/data8-err.s |  6 ++++++
 gas/testsuite/gas/microblaze/data8.d     | 11 +++++++++++
 gas/testsuite/gas/microblaze/data8.exp   |  6 ++++++
 gas/testsuite/gas/microblaze/data8.s     |  9 +++++++++
 gas/testsuite/gas/microblaze/errors.exp  |  1 +
 9 files changed, 70 insertions(+), 2 deletions(-)
 create mode 100644 gas/testsuite/gas/microblaze/data8-el.d
 create mode 100644 gas/testsuite/gas/microblaze/data8-err.d
 create mode 100644 gas/testsuite/gas/microblaze/data8-err.l
 create mode 100644 gas/testsuite/gas/microblaze/data8-err.s
 create mode 100644 gas/testsuite/gas/microblaze/data8.d
 create mode 100644 gas/testsuite/gas/microblaze/data8.exp
 create mode 100644 gas/testsuite/gas/microblaze/data8.s

diff --git a/gas/config/tc-microblaze.c b/gas/config/tc-microblaze.c
index c204990a6b7..603a322dbe5 100644
--- a/gas/config/tc-microblaze.c
+++ b/gas/config/tc-microblaze.c
@@ -2434,6 +2434,21 @@ md_apply_fix (fixS *   fixP,
       return;
     }
 
+  /* Eight bytes of data, which cons_fix_new_microblaze marked.  There
+     is no 64-bit data relocation, so the value must be known.  */
+  if (fixP->fx_r_type == BFD_RELOC_64 && fixP->fx_tcbit)
+    {
+      if (fixP->fx_addsy == NULL)
+	{
+	  md_number_to_chars (buf, val, 8);
+	  fixP->fx_done = 1;
+	}
+      else
+	as_bad_where (fixP->fx_file, fixP->fx_line,
+		      _("cannot represent a 64-bit data relocation"));
+      return;
+    }
+
   switch (fixP->fx_r_type)
     {
     case BFD_RELOC_MICROBLAZE_32_LO:
@@ -2937,8 +2952,10 @@ cons_fix_new_microblaze (fragS * frag,
           r = BFD_RELOC_32;
           break;
         case 8:
-          r = BFD_RELOC_64;
-          break;
+	  /* BFD_RELOC_64 is otherwise the IMM pair of an instruction;
+	     fx_tcbit tells md_apply_fix that this is data.  */
+	  fix_new_exp (frag, where, size, exp, 0, BFD_RELOC_64)->fx_tcbit = 1;
+	  return;
         default:
           as_bad (_("unsupported BFD relocation size %u"), size);
           r = BFD_RELOC_32;
diff --git a/gas/testsuite/gas/microblaze/data8-el.d b/gas/testsuite/gas/microblaze/data8-el.d
new file mode 100644
index 00000000000..eccdcd29967
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/data8-el.d
@@ -0,0 +1,11 @@
+#as: -EL
+#objdump: -rs -j .data
+#name: MicroBlaze .8byte, little endian
+#source: data8.s
+
+.*: +file format .*
+
+Contents of section \.data:
+ 0000 01000000 14000000 00000000 ecffffff  .*
+ 0010 ffffffff f0debc9a 78563412 feffffff  .*
+ 0020 ffffffff +.*
