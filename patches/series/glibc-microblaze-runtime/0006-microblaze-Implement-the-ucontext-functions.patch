diff --git a/sysdeps/unix/sysv/linux/microblaze/getcontext.S b/sysdeps/unix/sysv/linux/microblaze/getcontext.S
new file mode 100644
index 0000000000..d132cd2a10
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/microblaze/getcontext.S
@@ -0,0 +1,68 @@
+/* Save current context.  MicroBlaze version.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#include <sysdep.h>
+#include "ucontext_i.h"
+
+/* int getcontext (ucontext_t *ucp)
+
+   Saves the registers the ABI makes the callee preserve (r1, r2, r13,
+   r19-r31), the return address in r15, and the address the caller
+   resumes at, then reads the signal mask into uc_sigmask.  Returns 0;
+   a context resumed with setcontext also returns 0 from here.  */
+
+	.text
+ENTRY (__getcontext)
+	swi	r1,r5,UCONTEXT_MCONTEXT + 1*4
+	swi	r2,r5,UCONTEXT_MCONTEXT + 2*4
+	swi	r13,r5,UCONTEXT_MCONTEXT + 13*4
+	swi	r15,r5,UCONTEXT_MCONTEXT + 15*4
+	swi	r19,r5,UCONTEXT_MCONTEXT + 19*4
+	swi	r20,r5,UCONTEXT_MCONTEXT + 20*4
+	swi	r21,r5,UCONTEXT_MCONTEXT + 21*4
+	swi	r22,r5,UCONTEXT_MCONTEXT + 22*4
+	swi	r23,r5,UCONTEXT_MCONTEXT + 23*4
+	swi	r24,r5,UCONTEXT_MCONTEXT + 24*4
+	swi	r25,r5,UCONTEXT_MCONTEXT + 25*4
+	swi	r26,r5,UCONTEXT_MCONTEXT + 26*4
+	swi	r27,r5,UCONTEXT_MCONTEXT + 27*4
+	swi	r28,r5,UCONTEXT_MCONTEXT + 28*4
+	swi	r29,r5,UCONTEXT_MCONTEXT + 29*4
+	swi	r30,r5,UCONTEXT_MCONTEXT + 30*4
+	swi	r31,r5,UCONTEXT_MCONTEXT + 31*4
+	/* Resume after the call that brought us here.  */
+	addik	r3,r15,8
+	swi	r3,r5,MCONTEXT_PC
+
+	/* rt_sigprocmask (SIG_BLOCK, NULL, &ucp->uc_sigmask, _NSIG8).  */
+	addik	r7,r5,UCONTEXT_SIGMASK
+	addk	r6,r0,r0
+	addik	r8,r0,_NSIG8
+	addik	r5,r0,SIG_BLOCK
+	addik	r12,r0,SYS_ify (rt_sigprocmask)
+	brki	r14,8
+	nop
+	addik	r12,r0,-4095
+	cmpu	r12,r12,r3
+	bgei	r12,SYSCALL_ERROR_LABEL
+
+	rtsd	r15,8
+	addk	r3,r0,r0
+PSEUDO_END (__getcontext)
+
+weak_alias (__getcontext, getcontext)
diff --git a/sysdeps/unix/sysv/linux/microblaze/makecontext.c b/sysdeps/unix/sysv/linux/microblaze/makecontext.c
new file mode 100644
index 0000000000..b47e49a402
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/microblaze/makecontext.c
@@ -0,0 +1,75 @@
+/* Create new context.  MicroBlaze version.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#include <stdarg.h>
+#include <stdint.h>
+#include <ucontext.h>
+
+/* makecontext sets up a stack and the registers so that setcontext
+   starts FUNC with ARGC arguments and returns to __startcontext.
+
+   The stack looks like this:
+
+		+-----------------------+
+		| padding as required   |
+		+-----------------------+
+		| parameters 7 to n     |
+		+-----------------------+
+		| six argument home     |
+		| slots and the link    |
+		| register slot (28     |
+    sp ->	| bytes, ABI reserved)  |
+		+-----------------------+
+
+   The registers are set up like this:
+     r5-r10 : parameters 1 to 6
+     r19    : uc_link, preserved by FUNC and read by __startcontext
+     r15    : __startcontext - 8, so that FUNC's "rtsd r15,8" returns there
+     r1     : stack pointer
+     pc     : FUNC.  */
+
+void
+__makecontext (ucontext_t *ucp, void (*func) (void), int argc, ...)
+{
+  extern void __startcontext (void);
+  unsigned long int *sp;
+  va_list ap;
+  int i;
+
+  sp = (unsigned long int *)
+    ((uintptr_t) ucp->uc_stack.ss_sp + ucp->uc_stack.ss_size);
+
+  /* Stack parameters, then the 28-byte area the callee expects.  */
+  sp -= (argc > 6 ? argc - 6 : 0) + 7;
+  sp = (unsigned long int *) ((uintptr_t) sp & -8L);
+
+  ucp->uc_mcontext.regs.r1 = (uintptr_t) sp;
+  ucp->uc_mcontext.regs.r15 = (uintptr_t) &__startcontext - 8;
+  ucp->uc_mcontext.regs.r19 = (uintptr_t) ucp->uc_link;
+  ucp->uc_mcontext.regs.pc = (uintptr_t) func;
+
+  va_start (ap, argc);
+  for (i = 0; i < argc; ++i)
+    if (i < 6)
+      (&ucp->uc_mcontext.regs.r5)[i] = va_arg (ap, unsigned long int);
+    else
+      sp[7 + i - 6] = va_arg (ap, unsigned long int);
+  va_end (ap);
+}
+
+weak_alias (__makecontext, makecontext)
diff --git a/sysdeps/unix/sysv/linux/microblaze/setcontext.S b/sysdeps/unix/sysv/linux/microblaze/setcontext.S
new file mode 100644
index 0000000000..da49cafb54
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/microblaze/setcontext.S
@@ -0,0 +1,113 @@
+/* Install given context.  MicroBlaze version.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#include <sysdep.h>
+#include "ucontext_i.h"
+
+/* int setcontext (const ucontext_t *ucp)
+
+   Restores the signal mask, the argument registers (for a context made
+   by makecontext), the registers saved by getcontext, and jumps to the
+   saved pc with r3 = 0.  */
+
+	.text
+ENTRY (__setcontext)
+	/* Keep ucp in the callee-saved r19 across the system call.  The
+	   caller's r19 goes in the save slot the caller reserves for r5,
+	   so that a failing call can restore it; on success r19 is
+	   reloaded from the context.  */
+	swi	r19,r1,4
+	addk	r19,r5,r0
+
+	/* rt_sigprocmask (SIG_SETMASK, &ucp->uc_sigmask, NULL, _NSIG8).  */
+	addik	r6,r5,UCONTEXT_SIGMASK
+	addk	r7,r0,r0
+	addik	r8,r0,_NSIG8
+	addik	r5,r0,SIG_SETMASK
+	addik	r12,r0,SYS_ify (rt_sigprocmask)
+	brki	r14,8
+	nop
+	addik	r12,r0,-4095
+	cmpu	r12,r12,r3
+	bgei	r12,L(error)
+
+	/* Argument registers, for a context set up by makecontext.  */
+	lwi	r5,r19,UCONTEXT_MCONTEXT + 5*4
+	lwi	r6,r19,UCONTEXT_MCONTEXT + 6*4
+	lwi	r7,r19,UCONTEXT_MCONTEXT + 7*4
+	lwi	r8,r19,UCONTEXT_MCONTEXT + 8*4
+	lwi	r9,r19,UCONTEXT_MCONTEXT + 9*4
+	lwi	r10,r19,UCONTEXT_MCONTEXT + 10*4
+
+	/* Registers saved by getcontext.  */
+	lwi	r1,r19,UCONTEXT_MCONTEXT + 1*4
+	lwi	r2,r19,UCONTEXT_MCONTEXT + 2*4
+	lwi	r13,r19,UCONTEXT_MCONTEXT + 13*4
+	lwi	r15,r19,UCONTEXT_MCONTEXT + 15*4
+	lwi	r20,r19,UCONTEXT_MCONTEXT + 20*4
+	lwi	r21,r19,UCONTEXT_MCONTEXT + 21*4
+	lwi	r22,r19,UCONTEXT_MCONTEXT + 22*4
+	lwi	r23,r19,UCONTEXT_MCONTEXT + 23*4
+	lwi	r24,r19,UCONTEXT_MCONTEXT + 24*4
+	lwi	r25,r19,UCONTEXT_MCONTEXT + 25*4
+	lwi	r26,r19,UCONTEXT_MCONTEXT + 26*4
+	lwi	r27,r19,UCONTEXT_MCONTEXT + 27*4
+	lwi	r28,r19,UCONTEXT_MCONTEXT + 28*4
+	lwi	r29,r19,UCONTEXT_MCONTEXT + 29*4
+	lwi	r30,r19,UCONTEXT_MCONTEXT + 30*4
+	lwi	r31,r19,UCONTEXT_MCONTEXT + 31*4
+	lwi	r12,r19,MCONTEXT_PC
+	lwi	r19,r19,UCONTEXT_MCONTEXT + 19*4
+
+	brad	r12
+	addk	r3,r0,r0
+
+L(error):
+	brid	SYSCALL_ERROR_LABEL
+	lwi	r19,r1,4
+PSEUDO_END (__setcontext)
+
+weak_alias (__setcontext, setcontext)
+
+	/* A function started by makecontext returns here through r15 =
+	   __startcontext - 8, and an unwinder looks up the FDE for the
+	   address before __startcontext.  Keep that address outside any
+	   FDE, as sparc does, so that the lookup does not find
+	   __setcontext.  */
+	nop
+	nop
+
+ENTRY (__startcontext)
+	/* makecontext put uc_link in r19, which the function preserved.  */
+	beqid	r19,1f
+	addk	r5,r19,r0
+	brid	__setcontext
+	nop
+1:
+#ifdef PIC
+	mfs	r20,rpc
+	addik	r20,r20,_GLOBAL_OFFSET_TABLE_+8
+	lwi	r12,r20,exit@GOT
+	brald	r15,r12
+	addk	r5,r0,r0
+#else
+	brlid	r15,exit
+	addk	r5,r0,r0
+#endif
+	nop
+END (__startcontext)
diff --git a/sysdeps/unix/sysv/linux/microblaze/swapcontext.S b/sysdeps/unix/sysv/linux/microblaze/swapcontext.S
