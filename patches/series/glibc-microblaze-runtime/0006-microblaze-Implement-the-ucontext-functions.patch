index 0000000000..baf0de62bc
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/microblaze/swapcontext.S
@@ -0,0 +1,103 @@
+/* Save current context and install the given one.  MicroBlaze version.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
