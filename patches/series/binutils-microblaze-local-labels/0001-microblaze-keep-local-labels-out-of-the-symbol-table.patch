-[0-9a-f]+ R_MICROBLAZE_SUB16 +.*
+[0-9a-f]+ R_MICROBLAZE_SUB16 +\.text\+0x0+8
 [0-9a-f]+ R_MICROBLAZE_ADD16 +\.text\+0x0+18
-[0-9a-f]+ R_MICROBLAZE_SUB16 +.*
+[0-9a-f]+ R_MICROBLAZE_SUB16 +\.text\+0x0+10
