+#source: relax-cfi.s
+#as: -EL -g
+#ld: -EL -relax -T $srcdir/$subdir/relax-diff.ld
+#readelf: -sW
+#name: MicroBlaze relaxation with -g keeps local labels out of the symbol table
+
+# The CFA and line advances and the DWARF lengths are pairs of ADD and
+# SUB relocations.  Each SUB was against one of the assembler's L0^A
+# labels, which then reached the executable: 27 symbols instead of 12.
+
+Symbol table '\.symtab' contains 12 entries:
+#...
+ +[0-9]+: 0+ +0 FILE +LOCAL +DEFAULT +ABS .*
+ +[0-9]+: 90000024 +0 NOTYPE +LOCAL +DEFAULT +1 far
+ +[0-9]+: 90000000 +36 FUNC +GLOBAL +DEFAULT +1 _start
