diff --git a/bfd/elf32-microblaze.c b/bfd/elf32-microblaze.c
index 2d332b4a3b9..e8e90969b7e 100644
--- a/bfd/elf32-microblaze.c
+++ b/bfd/elf32-microblaze.c
@@ -1120,6 +1120,32 @@ microblaze_elf_is_local_label_name (bfd *abfd, const char *name)
   return _bfd_elf_is_local_label_name (abfd, name);
 }
 
+/* Treat local labels as special symbols, so that nm and objdump omit
+   them.  gas keeps them in the symbol table when a relocation needs
+   them, as for the difference of two code labels.  From
+   riscv_elf_is_target_special_symbol.  */
+
+static bool
+microblaze_elf_is_target_special_symbol (bfd *abfd, asymbol *sym)
+{
+  return (sym->name[0] == '\0'
+	  || microblaze_elf_is_local_label_name (abfd, sym->name));
+}
+
+/* Do not choose a local label as a function name.  From
+   riscv_maybe_function_sym.  */
+
+static bfd_size_type
+microblaze_elf_maybe_function_sym (const asymbol *sym, asection *sec,
+				   bfd_vma *code_off)
+{
+  if ((sym->flags & BSF_LOCAL) != 0
+      && microblaze_elf_is_local_label_name (sec->owner, sym->name))
+    return 0;
+
+  return _bfd_elf_maybe_function_sym (sym, sec, code_off);
+}
+
 /* Support for core dump NOTE sections.  */
 
 static bool
@@ -4252,12 +4278,15 @@ microblaze_elf_add_symbol_hook (bfd *abfd,
 
 #define bfd_elf32_bfd_reloc_type_lookup		microblaze_elf_reloc_type_lookup
 #define bfd_elf32_bfd_is_local_label_name	microblaze_elf_is_local_label_name
+#define bfd_elf32_bfd_is_target_special_symbol \
+  microblaze_elf_is_target_special_symbol
 #define bfd_elf32_new_section_hook		microblaze_elf_new_section_hook
 #define elf_backend_relocate_section		microblaze_elf_relocate_section
 #define bfd_elf32_bfd_relax_section		microblaze_elf_relax_section
 #define bfd_elf32_bfd_merge_private_bfd_data	_bfd_generic_verify_endian_match
 #define bfd_elf32_bfd_reloc_name_lookup		microblaze_elf_reloc_name_lookup
 
+#define elf_backend_maybe_function_sym	microblaze_elf_maybe_function_sym
 #define elf_backend_gc_mark_hook		microblaze_elf_gc_mark_hook
 #define elf_backend_check_relocs		microblaze_elf_check_relocs
 #define elf_backend_copy_indirect_symbol	microblaze_elf_copy_indirect_symbol
diff --git a/binutils/readelf.c b/binutils/readelf.c
index 920f75a062a..8db4dc8bcf0 100644
--- a/binutils/readelf.c
+++ b/binutils/readelf.c
@@ -16604,8 +16604,10 @@ apply_relocations (Filedata *filedata,
 	    }
 
 	  addend = 0;
+	  /* A subtracting relocation subtracts S + A, and so subtracts
+	     its addend.  */
 	  if (is_rela)
-	    addend += rp->r_addend;
+	    addend += reloc_subtract ? -rp->r_addend : rp->r_addend;
 	  /* R_XTENSA_32, R_PJ_DATA_DIR32 and R_D30V_32_NORMAL are
 	     partial_inplace.  */
 	  if (!is_rela
diff --git a/gas/config/tc-microblaze.c b/gas/config/tc-microblaze.c
index b4cd0d8e9ca..e8682a407ee 100644
--- a/gas/config/tc-microblaze.c
+++ b/gas/config/tc-microblaze.c
@@ -2039,6 +2039,44 @@ md_convert_frag (bfd * abfd ATTRIBUTE_UNUSED,
     }
 }
 
+/* FIXP is the SUB half of a pair of relocations, which md_apply_fix
+   or microblaze_cfa_fix made after adjust_reloc_syms had run.  Make it
+   against the section symbol plus an offset, as adjust_reloc_syms did
+   for the ADD half, so that a local label such as gas's fake label or a
+   compiler's $L label does not reach the symbol table.  The linker
+   corrects the addend of either half when relaxation deletes code.  */
+
+static void
+microblaze_adjust_sub_sym (fixS *fixP)
+{
+  symbolS *sym = fixP->fx_addsy;
+  segT symsec;
+
+  resolve_symbol_value (sym);
+  if (S_FORCE_RELOC (sym, 1) || symbol_section_p (sym))
+    return;
+
+  symsec = S_GET_SEGMENT (sym);
+  if (bfd_is_abs_section (symsec)
+      || (symsec->flags & (SEC_MERGE | SEC_THREAD_LOCAL)) != 0)
+    return;
+
+  /* As adjust_reloc_syms, leave non-local symbols in linkonce sections
+     alone.  */
+  if (!S_IS_LOCAL (sym)
+      && ((symsec->flags & SEC_LINK_ONCE) != 0
+	  || startswith (segment_name (symsec), ".gnu.linkonce")))
+    return;
+
+  if (flag_reloc_section_sym == reloc_section_sym_none
+      || (flag_reloc_section_sym == reloc_section_sym_internal
+	  && !bfd_is_local_label (stdoutput, symbol_get_bfdsym (sym))))
+    return;
+
+  fixP->fx_offset += S_GET_VALUE (sym);
+  fixP->fx_addsy = section_symbol (symsec);
+}
+
 /* Applies the desired value to the specified location.
    Also sets up addends for 'rela' type relocations.  */
 /* Turn a BFD_RELOC_MICROBLAZE_CFA fixup, which microblaze_pre_output_hook
@@ -2064,6 +2102,7 @@ microblaze_cfa_fix (fixS *fixP)
   fixP->fx_subsy = NULL;
   fixP->fx_done = 0;
   fixP->fx_next->fx_done = 0;
+  microblaze_adjust_sub_sym (fixP->fx_next);
 
   /* Load the byte to get the subtype.  */
   subtype = bfd_get_8 (NULL, &((fragS *) (fixP->fx_frag->fr_opcode))->fr_literal[fixP->fx_where]);
@@ -2374,6 +2413,7 @@ md_apply_fix (fixS *   fixP,
       fixP->fx_next->fx_subsy = NULL;
       fixP->fx_next->fx_offset = 0;
       fixP->fx_next->fx_r_type = sub;
+      microblaze_adjust_sub_sym (fixP->fx_next);
       fixP->fx_subsy = NULL;
       fixP->fx_r_type = add;
       fixP->fx_done = 0;
