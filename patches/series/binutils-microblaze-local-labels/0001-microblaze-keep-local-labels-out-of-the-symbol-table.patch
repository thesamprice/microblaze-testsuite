diff --git a/gas/testsuite/gas/microblaze/local-syms.s b/gas/testsuite/gas/microblaze/local-syms.s
new file mode 100644
index 00000000000..caad48047d7
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/local-syms.s
@@ -0,0 +1,14 @@
+# Labels that gas keeps in the symbol table only because relocations
+# name them, as --reloc-section-sym=none forces here.  MicroBlaze local
+# labels start with $L or L., or with .L as on other ELF targets, and
+# 1f becomes .L1^B1.  nm omits them all and lists only f.
+
+	.text
+$L1:	nop
+L.2:	nop
+.L3:	nop
+f:	nop
+	.data
+	.4byte	$L1, L.2, .L3, f, 1f
+	.text
+1:	nop
