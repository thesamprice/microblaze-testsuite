diff --git a/gas/testsuite/gas/microblaze/bshift.s b/gas/testsuite/gas/microblaze/bshift.s
new file mode 100644
index 00000000000..235d3d6f312
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/bshift.s
@@ -0,0 +1,10 @@
+    .text
+    bslli r7, r4, 31
+    bsrai r7, r4, 31
+    bsrli r7, r4, 31
+    bslli r7, r4, 3
+    bsrai r7, r4, 3
+    bsrli r7, r4, 3
+    bsll r7, r4, r5
+    bsra r7, r4, r5
+    bsrl r7, r4, r5
diff --git a/opcodes/microblaze-opc.h b/opcodes/microblaze-opc.h
index 849769dbadc..fde7b94e694 100644
--- a/opcodes/microblaze-opc.h
+++ b/opcodes/microblaze-opc.h
@@ -92,8 +92,7 @@
 #define OPCODE_MASK_H124  0xFFFF07FF /* High 16, and low 11 bits.  */
 #define OPCODE_MASK_H1234 0xFFFFFFFF /* All 32 bits.  */
 #define OPCODE_MASK_H3    0xFC000600 /* High 6 bits and bits 21, 22.  */
-#define OPCODE_MASK_H3B   0xFC00F9E0 /* High 6 bits and bits 16:20 and
-					bits 23:26. */
+#define OPCODE_MASK_H3B   0xFC00FFE0 /* High 6 bits and bits 16:26.  */
 #define OPCODE_MASK_H32   0xFC00FC00 /* High 6 bits and bit 16-21.  */
 #define OPCODE_MASK_H32B  0xFC00F820 /* High 6 bits and bits 16:20 and
 					bit 26 */
