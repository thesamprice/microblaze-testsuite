diff --git a/ld/testsuite/ld-microblaze/relax-compressed-debug.d b/ld/testsuite/ld-microblaze/relax-compressed-debug.d
new file mode 100644
index 00000000000..9e330cb2c57
--- /dev/null
+++ b/ld/testsuite/ld-microblaze/relax-compressed-debug.d
@@ -0,0 +1,13 @@
+#source: relax-compressed-debug.s
+#as: --compress-debug-sections=zlib-gabi
+#ld: -relax -T $srcdir/$subdir/relax-diff.ld
+#objdump: -s -j .debug_info
+#name: MicroBlaze relaxation with a compressed debug section
+
+# The IMM at 0x90000000 is deleted, so .Lafter is at 0x90000008.
+
+.*: +file format .*
+
+Contents of section \.debug_info:
+ 0000 90000008 00000000 00000000 00000000  .*
+#pass
diff --git a/ld/testsuite/ld-microblaze/relax-compressed-debug.s b/ld/testsuite/ld-microblaze/relax-compressed-debug.s
new file mode 100644
index 00000000000..92c91172f67
--- /dev/null
+++ b/ld/testsuite/ld-microblaze/relax-compressed-debug.s
@@ -0,0 +1,22 @@
+/* A debug section assembled compressed, with a word against the code
+   section.  Relaxation adjusts the word's addend and must not need the
+   debug section's contents for that; it used to read them with
+   bfd_get_section_contents, which fails for a compressed section, and
+   the link stopped with "can't relax section".  */
+
+	.section .text.aaa,"ax",@progbits
+	.globl	_start
+_start:
+	brlid	r15, far
+	nop
+.Lafter:
+	nop
+
+	.section .text.zz,"ax",@progbits
+far:
+	rtsd	r15, 8
+	nop
+
+	.section .debug_info,"",@progbits
+	.4byte	.Lafter
+	.space	256
