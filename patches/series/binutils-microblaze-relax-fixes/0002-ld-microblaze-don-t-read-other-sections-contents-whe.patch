-		      immediate -= offset;
-		      irelscan->r_addend -= offset;
-	  microblaze_bfd_write_imm_value_32 (abfd, ocontents + irelscan->r_offset,
-					     irelscan->r_addend);
-		    }
-		}
+		case R_MICROBLAZE_32:
+		case R_MICROBLAZE_32_PCREL:
+		case R_MICROBLAZE_32_NONE:
+		case R_MICROBLAZE_64:
+		case R_MICROBLAZE_TEXTREL_64:
+		  irelscan->r_addend -= calc_fixup (irelscan->r_addend, 0, sec);
+		  break;
 
-	      if (ELF32_R_TYPE (irelscan->r_info) == (int) R_MICROBLAZE_64
-		  || (ELF32_R_TYPE (irelscan->r_info)
-			      == (int) R_MICROBLAZE_TEXTREL_64))
-		{
-		  isym = isymbuf + ELF32_R_SYM (irelscan->r_info);
+		case R_MICROBLAZE_32_PCREL_LO:
+		case R_MICROBLAZE_32_LO:
+		case R_MICROBLAZE_TEXTREL_32_LO:
+		  if (!microblaze_get_cached_contents (abfd, o, &ocontents))
+		    goto error_return;
+		  {
+		    unsigned long instr = bfd_get_32 (abfd, ocontents
+						      + irelscan->r_offset);
+		    bfd_vma target_address = instr & 0x0000ffff;
+
+		    offset = calc_fixup (target_address, 0, sec);
+		    irelscan->r_addend -= offset;
+		    microblaze_bfd_write_imm_value_32 (abfd,
+						       ocontents
+						       + irelscan->r_offset,
+						       irelscan->r_addend);
+		  }
+		  break;
 
