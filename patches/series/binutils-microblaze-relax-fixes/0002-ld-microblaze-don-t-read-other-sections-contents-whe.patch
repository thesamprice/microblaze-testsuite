-			}
-		      offset = calc_fixup (irelscan->r_addend, 0, sec);
-		      irelscan->r_addend -= offset;
-		    }
-		}
-	      else if (ELF32_R_TYPE (irelscan->r_info) == (int) R_MICROBLAZE_64_PCREL)
-		{
-		  isym = isymbuf + ELF32_R_SYM (irelscan->r_info);
+		case R_MICROBLAZE_64_PCREL:
+		  if (!microblaze_get_cached_contents (abfd, o, &ocontents))
+		    goto error_return;
+		  {
+		    unsigned long instr_hi = bfd_get_32 (abfd, ocontents
+							 + irelscan->r_offset);
+		    unsigned long instr_lo = bfd_get_32 (abfd, ocontents
+							 + irelscan->r_offset
+							 + INST_WORD_SIZE);
+		    bfd_vma immediate = (instr_hi & 0x0000ffff) << 16;
+
+		    immediate |= instr_lo & 0x0000ffff;
+		    offset = calc_fixup (immediate, 0, sec);
+		    immediate -= offset;
+		    irelscan->r_addend -= offset;
