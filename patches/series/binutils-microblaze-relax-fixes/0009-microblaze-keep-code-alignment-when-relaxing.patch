   subseg_set (seg, subseg);
 }
 
+/* Called by do_align.  If padding to a 2**N boundary in a code section
+   is needed, make it here, and mark it with an R_MICROBLAZE_ALIGN at its
+   start, which md_apply_fix completes with the size of the padding.
+   Linker relaxation deletes whole instructions, so smaller alignments
+   need no mark.  Return whether the padding was made.  */
+
+bool
+microblaze_frag_align_code (unsigned int n, char *fill, unsigned int len,
+			    unsigned int max)
+{
+  fixS *fixP;
+
+  if (n <= 2
+      || need_pass_2
+      || now_seg == absolute_section
+      || !subseg_text_p (now_seg))
+    return false;
+
+  fixP = fix_new (frag_now, frag_now_fix (), 0, NULL, n, false,
+		  BFD_RELOC_MICROBLAZE_ALIGN);
+  fixP->fx_no_overflow = 1;
+
+  /* As do_align does.  */
+  if (fill == NULL)
+    frag_align_code (n, max);
+  else if (len <= 1)
+    frag_align (n, *fill, max);
+  else
+    frag_align_pattern (n, fill, len, max);
+
+  fixP->tc_fix_data = frag_now;
+  return true;
+}
+
 void
 md_apply_fix (fixS *   fixP,
 	      valueT * valp,
@@ -2218,6 +2252,20 @@ md_apply_fix (fixS *   fixP,
   struct op_code_struct * opcode1;
   unsigned long inst1;
 
+  if (fixP->fx_r_type == BFD_RELOC_MICROBLAZE_ALIGN)
+    {
+      /* Frags have their final addresses now.  The addend holds the
+	 base-2 logarithm of the alignment, which microblaze_frag_align_code
+	 put in fx_offset, and the size of the padding.  */
+      valueT pad = (fixP->tc_fix_data->fr_address
+		    - (fixP->fx_frag->fr_address + fixP->fx_where));
+
+      fixP->fx_offset = (pad << 8) | (fixP->fx_offset & 0xff);
+      fixP->fx_addsy = section_symbol (absolute_section);
+      fixP->fx_done = 0;
+      return;
+    }
+
   symname = fixP->fx_addsy ? S_GET_NAME (fixP->fx_addsy) : _("<unknown>");
 
   /* fixP->fx_offset is supposed to be set up correctly for all
@@ -2711,6 +2759,7 @@ tc_gen_reloc (asection * section ATTRIBUTE_UNUSED, fixS * fixp)
