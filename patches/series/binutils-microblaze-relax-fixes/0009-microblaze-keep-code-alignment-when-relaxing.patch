+/* An R_MICROBLAZE_ALIGN: PAD bytes of padding at REL->r_offset, up to a
+   2**POWER boundary.  NEWPAD is the padding after this pass.  */
+
+struct microblaze_align
+{
+  Elf_Internal_Rela *rel;
+  bfd_vma pad;
+  bfd_vma newpad;
+  unsigned int power;
+};
+
+static int
+microblaze_rel_ptr_cmp (const void *a, const void *b)
+{
+  const Elf_Internal_Rela *ra = *(const Elf_Internal_Rela *const *) a;
+  const Elf_Internal_Rela *rb = *(const Elf_Internal_Rela *const *) b;
+
+  return ra->r_offset < rb->r_offset ? -1 : ra->r_offset > rb->r_offset;
+}
+
+static int
+microblaze_align_cmp (const void *a, const void *b)
+{
+  const struct microblaze_align *aa = a;
+  const struct microblaze_align *ab = b;
+
+  return microblaze_rel_ptr_cmp (&aa->rel, &ab->rel);
+}
+
+static int
+microblaze_relax_table_cmp (const void *a, const void *b)
+{
+  const struct relax_table *ta = a;
+  const struct relax_table *tb = b;
+
+  return ta->addr < tb->addr ? -1 : ta->addr > tb->addr;
+}
+
+/* Decide what this pass of relaxation deletes from a section: the IMMs
+   of the NCAND relocations in CANDS, whose values fit in 16 bits, and
+   padding at the NALIGN alignment points in ALIGNS.  Fill in SDATA's
+   relaxation table, rewrite the type of each relocation whose IMM goes,
+   and update the padding recorded in each R_MICROBLAZE_ALIGN.
+
+   Deleting D bytes before an alignment point with PAD bytes of padding
+   keeps its target aligned if the padding shrinks to (PAD + D) mod
+   2**POWER bytes.  That is no more than PAD only for some D; when it is
+   more, padding would have to be inserted.  Instead, keep IMMs before
+   the point, latest first, until it is not.  Keeping all of them makes
+   D zero, so this always succeeds.  Only ever deleting means that no
+   address increases, so no distance does either, and an IMM deleted in
+   an earlier pass is never needed again.  */
+
+static bool
+microblaze_elf_choose_deletions (struct _microblaze_elf_section_data *sdata,
+				 Elf_Internal_Rela **cands, size_t ncand,
+				 struct microblaze_align *aligns, size_t nalign)
+{
+  bool *keep = NULL;
+  size_t *start_cand = NULL;
+  bfd_vma *start_del = NULL;
+  size_t i, j, c;
+  bfd_vma del;
+
+  if (ncand == 0)
+    return true;
+
+  qsort (cands, ncand, sizeof (*cands), microblaze_rel_ptr_cmp);
+  if (nalign != 0)
+    {
+      qsort (aligns, nalign, sizeof (*aligns), microblaze_align_cmp);
+
+      keep = bfd_malloc (ncand * sizeof (*keep));
+      start_cand = bfd_malloc (nalign * sizeof (*start_cand));
+      start_del = bfd_malloc (nalign * sizeof (*start_del));
+      if (keep == NULL || start_cand == NULL || start_del == NULL)
+	{
+	  free (keep);
+	  free (start_cand);
+	  free (start_del);
+	  return false;
+	}
+      for (c = 0; c < ncand; c++)
+	keep[c] = true;
+
+      /* Walk the alignment points in order, counting in DEL the bytes
+	 deleted before the current one.  START_CAND and START_DEL hold
+	 the state on reaching each point, so that the walk can resume
+	 at the first point after an IMM it decides to keep.  */
+      j = 0;
+      c = 0;
+      del = 0;
+      while (j < nalign)
+	{
+	  bfd_vma mask = ((bfd_vma) 1 << aligns[j].power) - 1;
+	  bfd_vma newpad;
+
+	  start_cand[j] = c;
+	  start_del[j] = del;
+	  for (; c < ncand && cands[c]->r_offset < aligns[j].rel->r_offset; c++)
+	    if (keep[c])
+	      del += INST_WORD_SIZE;
+
+	  newpad = (aligns[j].pad + del) & mask;
+	  if (newpad <= aligns[j].pad)
+	    {
+	      aligns[j].newpad = newpad;
+	      del += aligns[j].pad - newpad;
+	      j++;
+	      continue;
+	    }
+
+	  /* Keep the last IMM before this point that was to go, and go
+	     back to the first point after it.  */
+	  while (c > 0 && !keep[c - 1])
+	    c--;
+	  if (c == 0)
+	    {
+	      /* Cannot happen: with nothing deleted before it, no point
+		 needs padding inserted.  Delete nothing.  */
+	      BFD_ASSERT (false);
+	      for (c = 0; c < ncand; c++)
+		keep[c] = false;
+	      for (j = 0; j < nalign; j++)
+		aligns[j].newpad = aligns[j].pad;
+	      break;
+	    }
+	  keep[c - 1] = false;
+	  while (j > 0
+		 && aligns[j - 1].rel->r_offset > cands[c - 1]->r_offset)
+	    j--;
+	  c = start_cand[j];
+	  del = start_del[j];
+	}
+    }
+
+  /* Build the table.  */
+  sdata->relax_count = 0;
+  for (c = 0; c < ncand; c++)
+    {
+      Elf_Internal_Rela *irel = cands[c];
+
+      if (keep != NULL && !keep[c])
+	continue;
+
+      sdata->relax[sdata->relax_count].addr = irel->r_offset;
+      sdata->relax[sdata->relax_count].size = INST_WORD_SIZE;
+      sdata->relax_count++;
+
+      /* Rewrite relocation type.  */
+      switch ((enum elf_microblaze_reloc_type) ELF32_R_TYPE (irel->r_info))
+	{
+	case R_MICROBLAZE_64_PCREL:
+	  irel->r_info = ELF32_R_INFO (ELF32_R_SYM (irel->r_info),
+				       (int) R_MICROBLAZE_32_PCREL_LO);
+	  break;
+	case R_MICROBLAZE_64:
+	  irel->r_info = ELF32_R_INFO (ELF32_R_SYM (irel->r_info),
+				       (int) R_MICROBLAZE_32_LO);
+	  break;
+	case R_MICROBLAZE_TEXTREL_64:
+	  irel->r_info = ELF32_R_INFO (ELF32_R_SYM (irel->r_info),
+				       (int) R_MICROBLAZE_TEXTREL_32_LO);
+	  break;
+	default:
+	  /* Cannot happen.  */
+	  BFD_ASSERT (false);
+	}
+    }
+
+  if (sdata->relax_count != 0)
+    for (i = 0; i < nalign; i++)
+      {
+	struct microblaze_align *a = &aligns[i];
+
+	if (a->newpad < a->pad)
+	  {
+	    sdata->relax[sdata->relax_count].addr = a->rel->r_offset + a->newpad;
+	    sdata->relax[sdata->relax_count].size = a->pad - a->newpad;
+	    sdata->relax_count++;
+	    a->rel->r_addend = (a->newpad << 8) | a->power;
+	  }
+      }
+
+  qsort (sdata->relax, sdata->relax_count, sizeof (*sdata->relax),
+	 microblaze_relax_table_cmp);
+
+  free (keep);
+  free (start_cand);
+  free (start_del);
+  return true;
+}
+
 static bool
 microblaze_elf_relax_section (bfd *abfd,
 			      asection *sec,
@@ -2352,6 +2565,9 @@ microblaze_elf_relax_section (bfd *abfd,
   size_t offset;
   bfd_vma src, dest;
   struct _microblaze_elf_section_data *sdata;
+  Elf_Internal_Rela **cands = NULL;
+  struct microblaze_align *aligns = NULL;
+  size_t ncand = 0, nalign = 0;
 
   /* We only do this once per section.  We may be able to delete some code
      by running multiple passes, but it is not worth it.  */
@@ -2395,12 +2611,38 @@ microblaze_elf_relax_section (bfd *abfd,
   if (sdata->relax == NULL)
     goto error_return;
 
+  cands = bfd_malloc (sec->reloc_count * sizeof (*cands));
+  aligns = bfd_malloc (sec->reloc_count * sizeof (*aligns));
+  if (cands == NULL || aligns == NULL)
+    goto error_return;
+
   irelend = internal_relocs + sec->reloc_count;
   for (irel = internal_relocs; irel < irelend; irel++)
     {
       bfd_vma symval;
       asection *sym_sec;
 
+      if (ELF32_R_TYPE (irel->r_info) == (int) R_MICROBLAZE_ALIGN)
+	{
+	  unsigned int power = irel->r_addend & 0xff;
+	  bfd_vma pad = (bfd_vma) irel->r_addend >> 8;
+
+	  /* Deleting whole instructions keeps 4-byte alignment.  The
+	     assembler skips padding beyond a .balign maximum, and then
+	     the target is not aligned; leave it so.  */
+	  if (power > 2
+	      && power < 31
+	      && pad < ((bfd_vma) 1 << power)
+	      && ((irel->r_offset + pad) & (((bfd_vma) 1 << power) - 1)) == 0)
+	    {
+	      aligns[nalign].rel = irel;
+	      aligns[nalign].pad = pad;
+	      aligns[nalign].power = power;
+	      nalign++;
+	    }
+	  continue;
+	}
+
       if ((ELF32_R_TYPE (irel->r_info) != (int) R_MICROBLAZE_64_PCREL)
 	  && (ELF32_R_TYPE (irel->r_info) != (int) R_MICROBLAZE_64)
 	  && (ELF32_R_TYPE (irel->r_info) != (int) R_MICROBLAZE_TEXTREL_64))
@@ -2502,34 +2744,13 @@ microblaze_elf_relax_section (bfd *abfd,
 
       if ((symval & 0xffff8000) == 0
 	  || (symval & 0xffff8000) == 0xffff8000)
-	{
-	  /* We can delete this instruction.  */
-	  sdata->relax[sdata->relax_count].addr = irel->r_offset;
-	  sdata->relax[sdata->relax_count].size = INST_WORD_SIZE;
-	  sdata->relax_count++;
-
-	  /* Rewrite relocation type.  */
-	  switch ((enum elf_microblaze_reloc_type) ELF32_R_TYPE (irel->r_info))
-	    {
-	    case R_MICROBLAZE_64_PCREL:
-	      irel->r_info = ELF32_R_INFO (ELF32_R_SYM (irel->r_info),
-					   (int) R_MICROBLAZE_32_PCREL_LO);
-	      break;
-	    case R_MICROBLAZE_64:
-	      irel->r_info = ELF32_R_INFO (ELF32_R_SYM (irel->r_info),
-					   (int) R_MICROBLAZE_32_LO);
-	      break;
-	    case R_MICROBLAZE_TEXTREL_64:
-	      irel->r_info = ELF32_R_INFO (ELF32_R_SYM (irel->r_info),
-					   (int) R_MICROBLAZE_TEXTREL_32_LO);
-	      break;
-	    default:
-	      /* Cannot happen.  */
-	      BFD_ASSERT (false);
-	    }
-	}
+	/* We can delete this instruction.  */
+	cands[ncand++] = irel;
     } /* Loop through all relocations.  */
 
+  if (!microblaze_elf_choose_deletions (sdata, cands, ncand, aligns, nalign))
+    goto error_return;
+
   /* Loop through the relocs again, and see if anything needs to change.  */
   if (sdata->relax_count > 0)
     {
@@ -2820,6 +3041,8 @@ microblaze_elf_relax_section (bfd *abfd,
   *again = sdata->relax_count != 0;
   free (sdata->relax);
   sdata->relax = NULL;
+  free (cands);
+  free (aligns);
   return true;
 
  error_return:
@@ -2832,6 +3055,8 @@ microblaze_elf_relax_section (bfd *abfd,
   free (sdata->relax);
   sdata->relax = NULL;
   sdata->relax_count = 0;
+  free (cands);
+  free (aligns);
   return false;
 }
 
