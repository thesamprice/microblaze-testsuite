diff --git a/ld/testsuite/ld-microblaze/relax-align.s b/ld/testsuite/ld-microblaze/relax-align.s
new file mode 100644
index 00000000000..70d5ca77711
--- /dev/null
+++ b/ld/testsuite/ld-microblaze/relax-align.s
@@ -0,0 +1,40 @@
+/* Alignment inside a relaxed section.  Relaxation deleted IMMs without
+   regard to it, so everything after a deleted IMM moved down by 4 and
+   lost its alignment: aligned16 ended up at 0x9000000c.
+
+   The assembler now marks the padding with R_MICROBLAZE_ALIGN.  An IMM
+   deleted before it has to be made up for by shrinking the padding; if
+   the padding is too small for that, the IMM stays.  */
+
+	.section .text.aaa,"ax",@progbits
+	.globl	_start
+_start:
+	/* 4 bytes of padding follow; deleting the IMM would need 8.  */
+	brlid	r15, far
+	nop
+	.balign	16
+aligned16:
+	/* Two IMMs go, and the 8 bytes of padding with them.  */
+	brlid	r15, far
+	nop
+	brlid	r15, far
+	nop
+	.balign	16
+b16:
+	nop
+	/* Three IMMs go, and 4 of the 8 bytes of padding.  */
+	brlid	r15, far
+	nop
+	brlid	r15, far
+	nop
+	brlid	r15, far
+	nop
+	.balign	16
+c16:
+	nop
+	.4byte	c16 - aligned16
+
+	.section .text.zz,"ax",@progbits
+far:
+	rtsd	r15, 8
+	nop
