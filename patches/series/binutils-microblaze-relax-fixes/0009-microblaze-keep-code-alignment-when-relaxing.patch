+90000030:	80000000 	or	r0, r0, r0
+90000034:	b9f40014 	brlid	r15, 20
+90000038:	80000000 	or	r0, r0, r0
+9000003c:	00000000 	add	r0, r0, r0
+
+90000040 <c16>:
