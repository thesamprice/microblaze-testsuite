diff --git a/gas/testsuite/gas/microblaze/reloc_align.s b/gas/testsuite/gas/microblaze/reloc_align.s
new file mode 100644
index 00000000000..3eff5d01f20
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/reloc_align.s
@@ -0,0 +1,20 @@
+# Alignment padding in code to more than 4 bytes is marked with
+# R_MICROBLAZE_ALIGN, whose addend holds the padding size in bits 8 and
+# up and the base-2 logarithm of the alignment in bits 0-7.  The last
+# .balign in .text needs more padding than its maximum and is skipped,
+# with a padding size of 0.
+
+	.text
+	nop
+	.balign	16
+	nop
+	.p2align 2
+	nop
+	.p2align 3
+	.balign	32, 0
+	.byte	1
+	.balign	16, , 4
+	nop
+	.data
+	.byte	1
+	.balign	16
diff --git a/include/elf/microblaze.h b/include/elf/microblaze.h
index b72d22555c1..b0ec9c5a3f0 100644
--- a/include/elf/microblaze.h
+++ b/include/elf/microblaze.h
@@ -77,6 +77,12 @@ START_RELOC_NUMBERS (elf_microblaze_reloc_type)
   RELOC_NUMBER (R_MICROBLAZE_SET6, 43)
   RELOC_NUMBER (R_MICROBLAZE_SET_ULEB128, 44)
   RELOC_NUMBER (R_MICROBLAZE_SUB_ULEB128, 45)
+  /* Marks alignment padding in a code section, so that linker
+     relaxation can keep the alignment when it deletes code before it.
+     The offset is the start of the padding; bits 0-7 of the addend are
+     the base-2 logarithm of the alignment, and the rest the number of
+     padding bytes.  */
+  RELOC_NUMBER (R_MICROBLAZE_ALIGN, 46)
 END_RELOC_NUMBERS (R_MICROBLAZE_max)
 
