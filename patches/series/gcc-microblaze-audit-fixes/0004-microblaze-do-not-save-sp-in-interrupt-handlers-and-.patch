diff --git a/gcc/testsuite/gcc.target/microblaze/others/interrupt_handler_cfi.c b/gcc/testsuite/gcc.target/microblaze/others/interrupt_handler_cfi.c
new file mode 100644
index 000000000..c68a2daae
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/interrupt_handler_cfi.c
@@ -0,0 +1,22 @@
+/* { dg-do compile } */
+/* { dg-options "-g -dA" } */
+
+/* An interrupt handler saved and restored sp like any register it uses,
+   and its CFI said that the interrupted code's sp was in that slot.  It
+   also recorded the save of r15 as the return address, which is in r14
+   for an interrupt.  */
+
+extern void g (void);
+
+void __attribute__ ((interrupt_handler))
+h (void)
+{
+  g ();
+}
+
+/* { dg-final { scan-assembler-not {swi\tr1,r1} } } */
+/* { dg-final { scan-assembler-not {DW_CFA_offset, column 0x1\n} } } */
+/* { dg-final { scan-assembler-not {DW_CFA_offset, column 0xf\n} } } */
+/* { dg-final { scan-assembler {DW_CFA_register\n\t\.uleb128 0xf\n\t\.uleb128 0xe\n} } } */
+/* { dg-final { scan-assembler {swi\tr15,r1,0} } } */
