diff --git a/gcc/testsuite/gcc.target/microblaze/others/interrupt_handler_frame.c b/gcc/testsuite/gcc.target/microblaze/others/interrupt_handler_frame.c
new file mode 100644
index 000000000..79679747f
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/interrupt_handler_frame.c
@@ -0,0 +1,17 @@
+/* { dg-do compile } */
+
+/* In a leaf interrupt handler sp is used only by the prologue, so it was
+   not yet live when the prologue allocated the frame but was by the time
+   .frame and .mask were printed, which counted a save of it: .frame said
+   one word more than the code allocated.  */
+
+int x, y;
+
+void __attribute__ ((interrupt_handler))
+h (void)
+{
+  x = y * 3 + x;
+}
+
+/* { dg-final { scan-assembler {\.frame\tr[0-9]+,([0-9]+),r15[^\n]*\n(?:[^\n]*\n)*?\taddik\tr1,r1,-\1\n} } } */
+/* { dg-final { scan-assembler-not {swi\tr1,r1} } } */
