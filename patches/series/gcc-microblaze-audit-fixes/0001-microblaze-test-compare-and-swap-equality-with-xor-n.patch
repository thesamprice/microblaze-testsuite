From 03da0a4c5eba0c7c82dcca8e1d265a6b02184f03 Mon Sep 17 00:00:00 2001
From: Samuel Price <thesamprice@gmail.com>
Date: Sun, 15 Nov 2026 05:52:26 -0500
Subject: [PATCH 1/8] microblaze: test compare-and-swap equality with xor, not
 cmp

atomic_compare_and_swapsi compared the loaded value with the expected
one using cmp.  cmp computes rB - rA and then replaces bit 31 of the
result with the signed comparison rA > rB, so when the two values
differ only in bit 31 the result can be zero: the loop treated them as
equal and stored the new value.  Every 32-bit __sync and __atomic
compare-and-swap was affected, e.g. memory -1 and expected 0x7fffffff.

Test equality with xor, which is zero exactly when the values are equal.

The new test calls __sync_bool_compare_and_swap,
__sync_val_compare_and_swap and __atomic_compare_exchange_n, which all
expand to atomic_compare_and_swapsi, with values that differ only in
bit 31.  Each call is in a no-interprocedural-analysis (noipa) wrapper
so that it runs on the target instead of being folded at compile time.
The built-ins are described at
https://gcc.gnu.org/onlinedocs/gcc/_005f_005fsync-Builtins.html and
https://gcc.gnu.org/onlinedocs/gcc/_005f_005fatomic-Builtins.html.

Assisted-by: Claude <noreply@anthropic.com>

gcc/ChangeLog:

	* config/microblaze/sync.md (atomic_compare_and_swapsi): Use xor
	rather than cmp for the equality test.

gcc/testsuite/ChangeLog:

	* gcc.target/microblaze/others/atomic-cas-run.c: New test.
---
 gcc/config/microblaze/sync.md                 |  2 +-
 .../microblaze/others/atomic-cas-run.c        | 95 +++++++++++++++++++
 2 files changed, 96 insertions(+), 1 deletion(-)
 create mode 100644 gcc/testsuite/gcc.target/microblaze/others/atomic-cas-run.c

diff --git a/gcc/config/microblaze/sync.md b/gcc/config/microblaze/sync.md
index cc094df95..777b9b1de 100644
--- a/gcc/config/microblaze/sync.md
+++ b/gcc/config/microblaze/sync.md
@@ -38,7 +38,7 @@
       "lwx  \t%1,%y2,r0\n\t"
       "addic\t%8,r0,0\n\t"
       "bnei \t%8,.-8\n\t"
-      "cmp  \t%8,%1,%3\n\t"
+      "xor  \t%8,%1,%3\n\t"
       "bnei \t%8,.+20\n\t"
       "swx  \t%4,%y2,r0\n\t"
       "addic\t%8,r0,0\n\t"
diff --git a/gcc/testsuite/gcc.target/microblaze/others/atomic-cas-run.c b/gcc/testsuite/gcc.target/microblaze/others/atomic-cas-run.c
new file mode 100644
index 000000000..992c43aec
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/atomic-cas-run.c
@@ -0,0 +1,95 @@
+/* { dg-do run } */
+
+/* The compare-and-swap loop used cmp for its equality test.  cmp replaces
+   bit 31 of the difference with the result of a signed comparison, so two
+   values that differ only in bit 31 compared equal and the swap was done
+   anyway.  */
+
+/* Only bit 31 set, and every bit but bit 31.  The shift is done unsigned
+   because 1 << 31 overflows int.  */
+#define BIT31 ((int) (1u << 31))
+#define ALL_BUT_BIT31 ((int) ((1u << 31) - 1))
+
+/* What each compare-and-swap tries to store.  */
+#define NEW_VALUE 5
+
+int memory;
+
+__attribute__ ((noipa)) int
+bool_compare_and_swap (int *ptr, int expected, int desired)
+{
+  return __sync_bool_compare_and_swap (ptr, expected, desired);
+}
+
+__attribute__ ((noipa)) int
+val_compare_and_swap (int *ptr, int expected, int desired)
+{
+  return __sync_val_compare_and_swap (ptr, expected, desired);
+}
+
+__attribute__ ((noipa)) int
+atomic_compare_exchange (int *ptr, int *expected, int desired)
+{
+  return __atomic_compare_exchange_n (ptr, expected, desired, 0,
+				      __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+}
+
+/* Run all three compare-and-swap forms with MEMORY starting at INITIAL
+   and EXPECTED as the value to compare against.  */
+
+static void
+check (int initial, int expected)
+{
+  int should_swap = (initial == expected);
+  int value_after = should_swap ? NEW_VALUE : initial;
+  int result;
+  int expected_inout;
+
+  /* Returns whether it swapped.  */
+  memory = initial;
+  result = bool_compare_and_swap (&memory, expected, NEW_VALUE);
+  if (result != should_swap)
+    __builtin_abort ();
+  if (memory != value_after)
+    __builtin_abort ();
+
+  /* Returns the old value.  */
+  memory = initial;
+  result = val_compare_and_swap (&memory, expected, NEW_VALUE);
+  if (result != initial)
+    __builtin_abort ();
+  if (memory != value_after)
+    __builtin_abort ();
+
+  /* Returns whether it swapped, and writes the old value to *expected.  */
+  memory = initial;
+  expected_inout = expected;
+  result = atomic_compare_exchange (&memory, &expected_inout, NEW_VALUE);
+  if (result != should_swap)
+    __builtin_abort ();
+  if (memory != value_after)
+    __builtin_abort ();
+  if (expected_inout != initial)
+    __builtin_abort ();
+}
+
+int
+main (void)
+{
+  /* Values that differ only in bit 31: must not swap.  */
+  check (-1, ALL_BUT_BIT31);
+  check (ALL_BUT_BIT31, -1);
+  check (BIT31, 0);
+  check (0, BIT31);
+  check (0x12345678, 0x12345678 | BIT31);
+  check (0x12345678 | BIT31, 0x12345678);
+
+  /* Equal values: must swap.  */
+  check (-1, -1);
+  check (BIT31, BIT31);
+
+  /* An ordinary mismatch: must not swap.  */
+  check (3, 4);
+
+  return 0;
+}
