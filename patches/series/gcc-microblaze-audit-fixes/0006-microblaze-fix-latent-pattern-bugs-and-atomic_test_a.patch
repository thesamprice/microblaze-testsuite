diff --git a/gcc/testsuite/gcc.target/microblaze/others/atomic-test-and-set-run.c b/gcc/testsuite/gcc.target/microblaze/others/atomic-test-and-set-run.c
new file mode 100644
index 000000000..465833575
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/atomic-test-and-set-run.c
@@ -0,0 +1,46 @@
+/* { dg-do run } */
+
+/* __atomic_test_and_set returned the old byte rather than true or false,
+   so a byte that held 0x80 gave 128.  Check every byte of a word, since
+   the byte is reached through an aligned word and a shift.  */
+
+extern void abort (void);
+
+union
+{
+  unsigned int w;
+  unsigned char b[4];
+} u __attribute__ ((aligned (4)));
+
+__attribute__ ((noipa)) int
+tas (unsigned char *p)
+{
+  return __atomic_test_and_set (p, __ATOMIC_SEQ_CST);
+}
+
+int
+main (void)
+{
+  int i;
+  static const unsigned char vals[] = { 0, 1, 0x80, 0xff, 0x7f, 0x81 };
+  unsigned int j;
+
+  for (i = 0; i < 4; i++)
+    for (j = 0; j < sizeof vals; j++)
+      {
+	u.w = 0x5a5a5a5a;
+	u.b[i] = vals[j];
+	if (tas (&u.b[i]) != (vals[j] != 0))
+	  abort ();
+	if (u.b[i] == 0)
+	  abort ();
+	if (vals[j] == 0 && u.b[i] != 1)
+	  abort ();
+	u.b[i] = 0x5a;
+	if (u.w != 0x5a5a5a5a)
+	  abort ();
+	if (tas (&u.b[i]) != 1)
+	  abort ();
+      }
+  return 0;
+}
diff --git a/gcc/testsuite/gcc.target/microblaze/others/move-nosplit-run.c b/gcc/testsuite/gcc.target/microblaze/others/move-nosplit-run.c
new file mode 100644
index 000000000..9c359fd6a
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/move-nosplit-run.c
@@ -0,0 +1,40 @@
+/* { dg-do run } */
+/* { dg-options "-fdisable-rtl-split1 -fdisable-rtl-split2 -fdisable-rtl-split3 -fdisable-rtl-split4 -fdisable-rtl-split5" } */
+/* { dg-prune-output "disable pass" } */
+
+/* The register-to-register alternatives of movdi and movdf are normally
+   split after reload, so their templates went unchecked: movdi printed a
+   two-operand addk, which does not assemble, and movdf printed a copy of
+   zero.  */
+
+extern void abort (void);
+
+__attribute__ ((noipa)) long long
+second_ll (long long a, long long b)
+{
+  return b;
+}
+
+__attribute__ ((noipa)) double
+second_d (double a, double b)
+{
+  return b;
+}
+
+__attribute__ ((noipa)) long long
+swap_ll (long long a)
+{
+  return (a << 32) | ((unsigned long long) a >> 32);
+}
+
+int
+main (void)
+{
+  if (second_ll (1, 0x123456789abcdefLL) != 0x123456789abcdefLL)
+    abort ();
+  if (second_d (1.0, 2.5) != 2.5)
+    abort ();
+  if (swap_ll (0x0000000100000002LL) != 0x0000000200000001LL)
+    abort ();
+  return 0;
+}
