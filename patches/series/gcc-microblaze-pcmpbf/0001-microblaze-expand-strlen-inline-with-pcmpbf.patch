diff --git a/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf-unaligned.c b/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf-unaligned.c
new file mode 100644
index 000000000..f7cb39431
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf-unaligned.c
@@ -0,0 +1,15 @@
+/* { dg-options "-O2 -mcpu=v10.0 -mxl-pattern-compare" } */
+
+/* Without a known word alignment, the word loads could fault past the
+   end of the string, so strlen stays a call.  */
+
+typedef __SIZE_TYPE__ size_t;
+
+size_t
+unaligned (const char *p)
+{
+  return __builtin_strlen (p);
+}
+
+/* { dg-final { scan-assembler-not "pcmpbf" } } */
+/* { dg-final { scan-assembler "brlid\tr15,strlen" } } */
diff --git a/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf.c b/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf.c
new file mode 100644
index 000000000..a5375d7b7
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf.c
@@ -0,0 +1,15 @@
+/* { dg-options "-O2 -mcpu=v10.0 -mxl-pattern-compare" } */
+
+/* strlen of a word-aligned string is expanded inline, using pcmpbf
+   against r0 to find the first zero byte of each word.  */
+
+typedef __SIZE_TYPE__ size_t;
+
+size_t
+aligned (const char *p)
+{
+  return __builtin_strlen (__builtin_assume_aligned (p, 4));
+}
+
+/* { dg-final { scan-assembler "pcmpbf\tr\[0-9\]+,r\[0-9\]+,r0" } } */
+/* { dg-final { scan-assembler-not "brlid\tr15,strlen" } } */
diff --git a/gcc/testsuite/gcc.target/microblaze/others/strlen-pcmpbf-run.c b/gcc/testsuite/gcc.target/microblaze/others/strlen-pcmpbf-run.c
new file mode 100644
index 000000000..18eabb720
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/others/strlen-pcmpbf-run.c
@@ -0,0 +1,37 @@
+/* strlen expanded inline with pcmpbf: every length from 0 to 3 words,
+   from every word-aligned start, with nonzero and zero bytes after the
+   terminator in the same word.  */
+
+/* { dg-do run } */
+/* { dg-options "-mxl-pattern-compare" } */
+
+typedef __SIZE_TYPE__ size_t;
+
+__attribute__ ((noipa)) size_t
+len (const char *p)
+{
+  return __builtin_strlen (__builtin_assume_aligned (p, 4));
+}
+
+static union { char c[32]; unsigned w; } buf;
+
+static const unsigned char fill[] = { 0x01, 0x7f, 0x80, 0xff };
+
+int
+main (void)
+{
+  for (int start = 0; start < 8; start += 4)
+    for (int n = 0; n < 12; n++)
+      for (int f = 0; f < 4; f++)
+	for (int tail = 0; tail < 2; tail++)
+	  {
+	    for (int i = 0; i < 32; i++)
+	      buf.c[i] = tail ? 0 : fill[(i + f) & 3];
+	    for (int i = 0; i < n; i++)
+	      buf.c[start + i] = fill[(i + f) & 3];
+	    buf.c[start + n] = 0;
+	    if (len (buf.c + start) != (size_t) n)
+	      __builtin_abort ();
+	  }
+  return 0;
+}
