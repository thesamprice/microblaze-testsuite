diff --git a/gcc/config/microblaze/microblaze-protos.h b/gcc/config/microblaze/microblaze-protos.h
index 09397c684..e0d3b8c92 100644
--- a/gcc/config/microblaze/microblaze-protos.h
+++ b/gcc/config/microblaze/microblaze-protos.h
@@ -34,6 +34,7 @@ extern void override_options (void);
 extern int microblaze_expand_shift (rtx *);
 extern bool microblaze_expand_move (machine_mode, rtx *);
 extern bool microblaze_expand_block_move (rtx, rtx, rtx, rtx);
+extern bool microblaze_expand_strlen (rtx, rtx, rtx);
 extern void microblaze_expand_divide (rtx *);
 extern void microblaze_expand_conditional_branch (machine_mode, rtx *);
 extern void microblaze_expand_conditional_branch_reg (machine_mode, rtx *);
diff --git a/gcc/config/microblaze/microblaze.cc b/gcc/config/microblaze/microblaze.cc
index d2ccfbac7..5e6ca7345 100644
--- a/gcc/config/microblaze/microblaze.cc
+++ b/gcc/config/microblaze/microblaze.cc
@@ -1303,6 +1303,72 @@ microblaze_expand_block_move (rtx dest, rtx src, rtx length, rtx align_rtx)
   return false;
 }
 
+/* Expand strlen of the string at SRC into RESULT.  ALIGN is the known
+   alignment of SRC in bytes.  Return false to emit a call instead.
+
+   Load a word at a time and stop at the first word in which pcmpbf
+   against r0 finds a zero byte.  An aligned word load cannot cross a
+   page or region boundary, so it faults only where a byte load of the
+   same word would; that is why the alignment has to be known.  The
+   rs6000 strlensi expander does the same with dlmzb.  */
+
+bool
+microblaze_expand_strlen (rtx result, rtx src, rtx align)
+{
+  if (!CONST_INT_P (align) || INTVAL (align) < UNITS_PER_WORD)
+    return false;
+
+  rtx start = copy_addr_to_reg (XEXP (src, 0));
+  rtx addr = gen_reg_rtx (Pmode);
+  rtx word = gen_reg_rtx (SImode);
+  rtx pos = gen_reg_rtx (SImode);
+  rtx_code_label *loop = gen_label_rtx ();
+
+  emit_move_insn (addr, start);
+  emit_label (loop);
+  emit_move_insn (word, change_address (src, SImode, addr));
+  emit_insn (gen_addsi3 (addr, addr, GEN_INT (UNITS_PER_WORD)));
+  emit_insn (gen_pcmpbf (pos, word, const0_rtx));
+  emit_cmp_and_jump_insns (pos, const0_rtx, EQ, NULL_RTX, SImode, 1, loop);
+
+  /* ADDR is now one word past the word holding the zero byte.  pcmpbf
+     numbers the bytes 1 to 4 from the most significant, which is memory
+     order only when big-endian.  */
+  if (!BYTES_BIG_ENDIAN)
+    {
+      if (TARGET_REORDER)
+	{
+	  emit_insn (gen_bswapsi2 (word, word));
+	  emit_insn (gen_pcmpbf (pos, word, const0_rtx));
+	}
+      else
+	{
+	  /* Find the zero byte with byte loads; one of the four is zero.  */
+	  rtx byte = gen_reg_rtx (SImode);
+	  rtx_code_label *bloop = gen_label_rtx ();
+	  rtx_code_label *found = gen_label_rtx ();
+	  emit_insn (gen_addsi3 (addr, addr, GEN_INT (-UNITS_PER_WORD)));
+	  emit_label (bloop);
+	  emit_insn (gen_zero_extendqisi2 (byte,
+					   change_address (src, QImode,
+							   addr)));
+	  emit_cmp_and_jump_insns (byte, const0_rtx, EQ, NULL_RTX, SImode, 1,
+				   found);
+	  emit_insn (gen_addsi3 (addr, addr, const1_rtx));
+	  emit_jump (bloop);
+	  emit_label (found);
+	  emit_insn (gen_subsi3 (result, addr, start));
+	  return true;
+	}
+    }
+
+  /* The zero byte is at ADDR - UNITS_PER_WORD + POS - 1.  */
+  emit_insn (gen_addsi3 (addr, addr, pos));
+  emit_insn (gen_addsi3 (start, start, GEN_INT (UNITS_PER_WORD + 1)));
+  emit_insn (gen_subsi3 (result, addr, start));
+  return true;
+}
+
 /* Compute memory address *aligned_mem and corresponding shift value (*shift)
    from a QImode memory reference MEM */
 void
diff --git a/gcc/config/microblaze/microblaze.md b/gcc/config/microblaze/microblaze.md
index eff3b64b2..f38c0add5 100644
--- a/gcc/config/microblaze/microblaze.md
+++ b/gcc/config/microblaze/microblaze.md
@@ -52,6 +52,8 @@
 
 (define_c_enum "unspec" [
   UNSPEC_IPREFETCH
+  UNSPEC_PCMPBF
+  UNSPEC_STRLEN
 ])
 
 ;;----------------------------------------------------
@@ -1660,6 +1662,41 @@
   (set_attr "length"	"4")]
 )              
 
+;;----------------------------------------------------------------
+;; String length
+;;----------------------------------------------------------------
+
+;; pcmpbf: 1 to 4 for the first byte, counting from the most
+;; significant, that equals the same byte of operand 2; 0 if none does.
+(define_insn "pcmpbf"
+  [(set (match_operand:SI 0 "register_operand" "=d")
+	(unspec:SI [(match_operand:SI 1 "register_operand" "d")
+		    (match_operand:SI 2 "reg_or_0_operand" "dJ")]
+		   UNSPEC_PCMPBF))]
+  "TARGET_PATTERN_COMPARE"
+  "pcmpbf\t%0,%1,%z2"
+  [(set_attr "type"	"arith")
+   (set_attr "mode"	"SI")
+   (set_attr "length"	"4")]
+)
+
+;; Operand 0 is the length, 1 the string, 2 the character searched for
+;; (always zero) and 3 the known alignment in bytes.
+(define_expand "strlensi"
+  [(set (match_operand:SI 0 "register_operand")
+	(unspec:SI [(match_operand:BLK 1 "memory_operand")
+		    (match_operand:SI 2 "const_int_operand")
+		    (match_operand:SI 3 "const_int_operand")]
+		   UNSPEC_STRLEN))]
+  "TARGET_PATTERN_COMPARE"
+{
+  if (operands[2] != const0_rtx
+      || optimize_insn_for_size_p ()
+      || !microblaze_expand_strlen (operands[0], operands[1], operands[3]))
+    FAIL;
+  DONE;
+})
+
 ;;----------------------------------------------------------------
 ;; Setting a register from an floating point comparison. 
 ;;----------------------------------------------------------------
diff --git a/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf-le-reorder.c b/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf-le-reorder.c
new file mode 100644
index 000000000..5279930fe
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf-le-reorder.c
@@ -0,0 +1,16 @@
+/* { dg-options "-O2 -mcpu=v10.0 -mxl-pattern-compare -mlittle-endian -mxl-reorder" } */
+
+/* With swapb, the word that holds the zero is byte-reversed and
+   searched again, so pcmpbf numbers its bytes in memory order.  */
+
+typedef __SIZE_TYPE__ size_t;
+
+size_t
+aligned (const char *p)
+{
+  return __builtin_strlen (__builtin_assume_aligned (p, 4));
+}
+
+/* { dg-final { scan-assembler-times "pcmpbf\tr\[0-9\]+,r\[0-9\]+,r0" 2 } } */
+/* { dg-final { scan-assembler "swapb\[ \t\]" } } */
+/* { dg-final { scan-assembler-not "brlid\tr15,strlen" } } */
diff --git a/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf-le.c b/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf-le.c
new file mode 100644
index 000000000..ace18f367
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/isa/strlen-pcmpbf-le.c
@@ -0,0 +1,19 @@
+/* { dg-options "-O2 -mcpu=v10.0 -mxl-pattern-compare -mlittle-endian -mno-xl-reorder" } */
+
+/* pcmpbf numbers the bytes from the most significant one, which on a
+   little-endian core is the last byte of the word in memory.  It still
+   says whether the word holds a zero; the byte is then found with
+   byte loads.  */
+
+typedef __SIZE_TYPE__ size_t;
+
+size_t
+aligned (const char *p)
+{
+  return __builtin_strlen (__builtin_assume_aligned (p, 4));
+}
+
+/* { dg-final { scan-assembler-times "pcmpbf\tr\[0-9\]+,r\[0-9\]+,r0" 1 } } */
+/* { dg-final { scan-assembler "lbui\t" } } */
+/* { dg-final { scan-assembler-not "swapb" } } */
+/* { dg-final { scan-assembler-not "brlid\tr15,strlen" } } */
