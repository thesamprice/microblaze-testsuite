From ca926abc81ad8ffc6be58dfb90fd1234d2a86520 Mon Sep 17 00:00:00 2001
From: Samuel Price <thesamprice@gmail.com>
Date: Sun, 8 Nov 2026 15:22:37 -0500
Subject: [PATCH 1/3] microblaze: shift double words by one through the carry

The port has no DImode shift patterns, so expand_doubleword_shift builds
a 64-bit shift by one from 32-bit shifts, moving the bit that crosses
between the words with a shift of 31 the other way.  Without a barrel
shifter that is 31 single-bit shifts.  The step that doubles the
remainder in libgcc2.c's shift-and-subtract __udivmoddi4 compiles to 35
instructions, 31 of them srl.

MicroBlaze passes that bit through the carry: add then addc shifts left,
and srl or sra then src shifts right.  Add expanders for the three
DImode shifts that accept a count of one and FAIL otherwise, and an insn
for each that emits the two instructions.  The step above becomes

	add	r23, r23, r23
	addc	r22, r22, r22

The pair stays in one pattern because the carry is not modelled.  The
destination may be the source, so a shift in a loop needs no copy.  A
destination that overlapped the source by one word would be wrong, since
the first instruction writes a word the second reads.  Double words live
in even register pairs, so that should not happen, but the new
microblaze_dword_overlap_p checks, and the pattern then goes through
r18, as other MicroBlaze patterns do.

With a barrel shifter the sequence goes from four instructions to two.
A function that does nothing but shift its 64-bit argument gains two
copies, because the argument arrives in the odd pair r5:r6.

Tested as part of this series on microblaze-elf and microblazeel-elf
under QEMU.

Assisted-by: Claude <noreply@anthropic.com>

gcc/
	* config/microblaze/microblaze.md (any_shiftrt): New code iterator.
	(shiftrt_insn, shiftrt_optab): New code attributes.
	(ashldi3, <shiftrt_optab>di3): New expanders.
	(*ashldi3_one, *<shiftrt_optab>di3_one): New insns.
	* config/microblaze/microblaze.cc (microblaze_dword_overlap_p): New
	function.
	* config/microblaze/microblaze-protos.h
	(microblaze_dword_overlap_p): Declare.

gcc/testsuite/
	* gcc.target/microblaze/isa/shiftdi-one.c: New test.
	* gcc.target/microblaze/isa/shiftdi-one-bshift.c: New test.
---
 gcc/config/microblaze/microblaze-protos.h     |  1 +
 gcc/config/microblaze/microblaze.cc           | 14 ++++
 gcc/config/microblaze/microblaze.md           | 70 +++++++++++++++++++
 .../microblaze/isa/shiftdi-one-bshift.c       | 18 +++++
 .../gcc.target/microblaze/isa/shiftdi-one.c   | 26 +++++++
 5 files changed, 129 insertions(+)
 create mode 100644 gcc/testsuite/gcc.target/microblaze/isa/shiftdi-one-bshift.c
 create mode 100644 gcc/testsuite/gcc.target/microblaze/isa/shiftdi-one.c

diff --git a/gcc/config/microblaze/microblaze-protos.h b/gcc/config/microblaze/microblaze-protos.h
index bee8f1d99..3ec9fff14 100644
--- a/gcc/config/microblaze/microblaze-protos.h
+++ b/gcc/config/microblaze/microblaze-protos.h
@@ -32,6 +32,7 @@ extern void microblaze_expand_prologue (void);
 extern void microblaze_expand_epilogue (void);
 extern void override_options (void);
 extern int microblaze_expand_shift (rtx *);
+extern bool microblaze_dword_overlap_p (rtx, bool, rtx, bool);
 extern bool microblaze_expand_move (machine_mode, rtx *);
 extern bool microblaze_expand_block_move (rtx, rtx, rtx, rtx);
 extern void microblaze_expand_divide (rtx *);
diff --git a/gcc/config/microblaze/microblaze.cc b/gcc/config/microblaze/microblaze.cc
index 398c8ffa7..50d30ad36 100644
--- a/gcc/config/microblaze/microblaze.cc
+++ b/gcc/config/microblaze/microblaze.cc
@@ -3531,6 +3531,20 @@ microblaze_expand_shift (rtx operands[])
   return 0;
 }
 
+/* Return true if the high (DST_HIGH) or low word of the double-word
+   register DST is the same register as the high (SRC_HIGH) or low word
+   of SRC.  Double words normally start at an even register, and then
+   the two never overlap by one word; the patterns that write one word
+   of their result before reading the other word of an input check
+   anyway.  */
+bool
+microblaze_dword_overlap_p (rtx dst, bool dst_high, rtx src, bool src_high)
+{
+  unsigned int d = REGNO (dst) + (dst_high != WORDS_BIG_ENDIAN);
+  unsigned int s = REGNO (src) + (src_high != WORDS_BIG_ENDIAN);
+  return d == s;
+}
+
 /* Return an RTX indicating where the return address to the
    calling function can be found.  */
 rtx
diff --git a/gcc/config/microblaze/microblaze.md b/gcc/config/microblaze/microblaze.md
index 906d4572d..2d86bd3d3 100644
--- a/gcc/config/microblaze/microblaze.md
+++ b/gcc/config/microblaze/microblaze.md
@@ -1648,6 +1648,76 @@
   (set_attr "length"   "28")]
 )
 
+;;----------------------------------------------------------------
+;; 64-bit shifts by one
+;;----------------------------------------------------------------
+
+;; A 64-bit shift by one passes the bit that crosses between the words
+;; through the carry: add and addc to the left, and srl or sra then src
+;; to the right.  Other counts FAIL, and the generic word-by-word
+;; expansion is used.  The two instructions stay in one pattern because
+;; the carry between them is not modelled.  The destination may be the
+;; source, so a shift in a loop needs no copy; a destination that
+;; overlaps the source by one word goes through r18.
+
+(define_code_iterator any_shiftrt [lshiftrt ashiftrt])
+(define_code_attr shiftrt_insn [(lshiftrt "srl") (ashiftrt "sra")])
+(define_code_attr shiftrt_optab [(lshiftrt "lshr") (ashiftrt "ashr")])
+
+(define_expand "ashldi3"
+  [(set (match_operand:DI 0 "register_operand")
+	(ashift:DI (match_operand:DI 1 "register_operand")
+		   (match_operand:SI 2 "arith_operand")))]
+  ""
+  {
+    if (operands[2] != const1_rtx)
+      FAIL;
+  }
+)
+
+(define_insn "*ashldi3_one"
+  [(set (match_operand:DI 0 "register_operand" "=d")
+	(ashift:DI (match_operand:DI 1 "register_operand" "d")
+		   (const_int 1)))]
+  ""
+  {
+    /* The low word is written before the high word is read.  */
+    if (microblaze_dword_overlap_p (operands[0], false, operands[1], true))
+      return "add\tr18,%L1,%L1\;addc\t%M0,%M1,%M1\;addk\t%L0,r18,r0";
+    return "add\t%L0,%L1,%L1\;addc\t%M0,%M1,%M1";
+  }
+  [(set_attr "type"	"darith")
+   (set_attr "mode"	"DI")
+   (set_attr "length"	"12")]
+)
+
+(define_expand "<shiftrt_optab>di3"
+  [(set (match_operand:DI 0 "register_operand")
+	(any_shiftrt:DI (match_operand:DI 1 "register_operand")
+			(match_operand:SI 2 "arith_operand")))]
+  ""
+  {
+    if (operands[2] != const1_rtx)
+      FAIL;
+  }
+)
+
+(define_insn "*<shiftrt_optab>di3_one"
+  [(set (match_operand:DI 0 "register_operand" "=d")
+	(any_shiftrt:DI (match_operand:DI 1 "register_operand" "d")
+			(const_int 1)))]
+  ""
+  {
+    /* The high word is written before the low word is read.  */
+    if (microblaze_dword_overlap_p (operands[0], true, operands[1], false))
+      return "<shiftrt_insn>\tr18,%M1\;src\t%L0,%L1\;addk\t%M0,r18,r0";
+    return "<shiftrt_insn>\t%M0,%M1\;src\t%L0,%L1";
+  }
+  [(set_attr "type"	"darith")
+   (set_attr "mode"	"DI")
+   (set_attr "length"	"12")]
+)
+
 ;;----------------------------------------------------------------
 ;; Setting a register from an integer comparison. 
 ;;----------------------------------------------------------------
diff --git a/gcc/testsuite/gcc.target/microblaze/isa/shiftdi-one-bshift.c b/gcc/testsuite/gcc.target/microblaze/isa/shiftdi-one-bshift.c
new file mode 100644
index 000000000..37b5544f1
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/isa/shiftdi-one-bshift.c
@@ -0,0 +1,18 @@
+/* With a barrel shifter, 64-bit shifts by one still use the carry.  */
+/* { dg-options "-O2 -mcpu=v10.0 -mxl-barrel-shift" } */
+
+unsigned long long
+lshr1 (unsigned long long x)
+{
+  return x >> 1;
+}
+
+unsigned long long
+ashl1 (unsigned long long x)
+{
+  return x << 1;
+}
+
+/* { dg-final { scan-assembler {\tsrl\tr[0-9]+,r[0-9]+\n\tsrc\tr[0-9]+,r[0-9]+\n} } } */
+/* { dg-final { scan-assembler {\taddc\tr[0-9]+,r([0-9]+),r\1\n} } } */
+/* { dg-final { scan-assembler-not {\tbs[rl]li\t} } } */
diff --git a/gcc/testsuite/gcc.target/microblaze/isa/shiftdi-one.c b/gcc/testsuite/gcc.target/microblaze/isa/shiftdi-one.c
new file mode 100644
index 000000000..672a259b8
--- /dev/null
+++ b/gcc/testsuite/gcc.target/microblaze/isa/shiftdi-one.c
@@ -0,0 +1,26 @@
+/* 64-bit shifts by one go through the carry in two instructions.  */
+/* { dg-options "-O2 -mcpu=v10.0" } */
+
+unsigned long long
+lshr1 (unsigned long long x)
+{
+  return x >> 1;
+}
+
+long long
+ashr1 (long long x)
+{
+  return x >> 1;
+}
+
+unsigned long long
+ashl1 (unsigned long long x)
+{
+  return x << 1;
+}
+
+/* { dg-final { scan-assembler {\tsrl\tr[0-9]+,r[0-9]+\n\tsrc\tr[0-9]+,r[0-9]+\n} } } */
+/* { dg-final { scan-assembler {\tsra\tr[0-9]+,r[0-9]+\n\tsrc\tr[0-9]+,r[0-9]+\n} } } */
+/* { dg-final { scan-assembler {\tadd\tr[0-9]+,r([0-9]+),r\1\n\taddc\tr[0-9]+,r([0-9]+),r\2\n} } } */
+/* { dg-final { scan-assembler-times {\tsrc\t} 2 } } */
+/* { dg-final { scan-assembler-not {\tandi\t} } } */
