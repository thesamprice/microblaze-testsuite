From b76441dc4a2dbbe7989671d5e0e01d98f1fa2625 Mon Sep 17 00:00:00 2001
From: Samuel Price <thesamprice@gmail.com>
Date: Sat, 7 Nov 2026 23:39:50 -0500
Subject: [PATCH 1/3] libgcc: mask out the quotient bits in __udivmoddi4

With TARGET_HAS_NO_HW_DIVIDE, __udivmoddi4 divides by shift and
subtract.  Its loop shifts each quotient bit into the low end of the
partial remainder, and the tail separates the two:

	q = q + r;
	r = r >> k;
	q = q - (r << k);

The low K bits of R are the quotient bits.  When the caller does not
want the remainder, as in __udivdi3 and __divdi3, this is
q + (r & ((1 << k) - 1)): one variable double-word shift instead of
two.  On a 32-bit target without a barrel shifter a variable
double-word shift is a loop.

This uses the mask only when RP is null, and keeps the existing tail
otherwise.  RP is constant wherever __udivmoddi4 is inlined, so only
one arm is compiled there.  An earlier version used the mask in both
cases and kept 1 << K live across the loop, which spilled a register
on armv6-m and made __aeabi_uldivmod 1.2% slower there.

[DRAFT: MicroBlaze and Cortex-M0 numbers are being re-measured.]

libgcc/
	* libgcc2.c (__udivmoddi4) [TARGET_HAS_NO_HW_DIVIDE]: Without RP,
	take the low quotient bits from R with a mask.

Assisted-by: Claude <noreply@anthropic.com>
---
 libgcc/libgcc2.c | 21 +++++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/libgcc/libgcc2.c b/libgcc/libgcc2.c
index 2d4434c6f..05c013201 100644
--- a/libgcc/libgcc2.c
+++ b/libgcc/libgcc2.c
@@ -973,10 +973,23 @@ __udivmoddi4 (UDWtype n, UDWtype d, UDWtype *rp)
 	    } while (i != 0);
 
 	  /* First quotient bit is combined with the quotient bits resulting
-	     from the k regular iterations.  */
-	  q = q + r;
-	  r = r >> k;
-	  q = q - (r << k);
+	     from the k regular iterations, which are the low K bits of R.  */
+	  if (rp)
+	    {
+	      q = q + r;
+	      r = r >> k;
+	      q = q - (r << k);
+	    }
+	  else
+	    {
+	      /* Without the remainder, mask the quotient bits out of R
+		 rather than shifting R down and back up: one variable
+		 shift instead of two, which matters where those are
+		 loops.  RP is constant wherever this is inlined, as in
+		 __udivdi3 and __divdi3, so only one arm is compiled
+		 there.  */
+	      q = q + (r & (((UDWtype) 1 << k) - 1));
+	    }
 	}
     }
 
