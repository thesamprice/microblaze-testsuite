new file mode 100644
index 0000000..f737f56
--- /dev/null
+++ b/newlib/libc/machine/microblaze/strlen-pcmp.S
@@ -0,0 +1,62 @@
+/* strlen for MicroBlaze with the pattern compare instructions.
+
+   Copyright (C) 2026 Sam Price
+
+   Permission to use, copy, modify, and distribute this software
+   is freely granted, provided that this notice is preserved.
+
+   With -mxl-pattern-compare this replaces the C strlen in strlen.c.
+
+   The head is a byte loop up to the first word boundary, so no load
+   crosses into a word that holds no byte of the string.  The body loads
+   a word at a time and lets pcmpbf find the NUL: it returns the position
+   of the first byte equal to zero, counting from the most significant
+   byte as 1, or 0 if there is none.  Loading with lw on big-endian and
+   lwr on little-endian puts the lowest-addressed byte in the most
+   significant position either way, so position N is address word + N - 1
+   in both, and the length follows without scanning the word again.  */
+
+#ifdef __HAVE_HW_PCMP__
+
+#ifdef __LITTLE_ENDIAN__
+#define LOAD4BYTES lwr
+#else
+#define LOAD4BYTES lw
+#endif
+
+	.text
+	.align	2
+	.globl	strlen
+	.type	strlen, @function
+	.ent	strlen
+strlen:
+	/* r5: the string.  r3: the address being looked at.  */
+	andi	r4, r5, 3
+	beqid	r4, .Lword
+	or	r3, r5, r0
+
+.Lbyte:
+	lbui	r4, r3, 0
+	beqi	r4, .Lend
+	addik	r3, r3, 1
+	andi	r4, r3, 3
+	bnei	r4, .Lbyte
+
+.Lword:
+	LOAD4BYTES	r6, r3, r0
+	pcmpbf	r4, r6, r0
+	beqid	r4, .Lword
+	addik	r3, r3, 4
+
+	/* r3 is 4 past the word with the NUL, and r4 is its position
+	   1 to 4, so the NUL is at r3 + r4 - 5.  */
+	addk	r3, r3, r4
+	addik	r3, r3, -5
+
+.Lend:
+	rtsd	r15, 8
+	rsubk	r3, r5, r3
+	.end	strlen
+	.size	strlen, . - strlen
+
+#endif /* __HAVE_HW_PCMP__ */
diff --git a/newlib/libc/machine/microblaze/strlen.c b/newlib/libc/machine/microblaze/strlen.c
index acb4464..e95f8c3 100644
--- a/newlib/libc/machine/microblaze/strlen.c
+++ b/newlib/libc/machine/microblaze/strlen.c
@@ -77,12 +77,12 @@ QUICKREF
 #error long int is not a 32bit or 64bit byte
 #endif
 
+/* With pattern compare, strlen-pcmp.S provides strlen.  */
+#ifndef __HAVE_HW_PCMP__
+
 size_t
 strlen (const char *str)
 {
-
-#ifndef HAVE_HW_PCMP
-
 #if defined(PREFER_SIZE_OVER_SPEED) || defined(__OPTIMIZE_SIZE__)
   const char *start = str;
 
@@ -111,40 +111,6 @@ strlen (const char *str)
     str++;
   return str - start;
 #endif /* not PREFER_SIZE_OVER_SPEED */
-
-#else
-
-#include "mb_endian.h"
-
-  asm volatile ("                                               \n\
-        or      r9, r0, r0              /* Index register */    \n\
-check_alignment:                                                \n\
-        andi    r3, r5, 3                                       \n\
-        bnei    r3, align_arg                                   \n\
-len_loop:                                                       \n"
-        LOAD4BYTES("r3", "r5", "r9")
-"                                                               \n\
-        pcmpbf  r4, r3, r0                                      \n\
-        bnei    r4, end_len                                     \n\
-        brid    len_loop                                        \n\
-        addik   r9, r9, 4                                       \n\
-end_len:                                                        \n\
-        lbu     r3, r5, r9                                      \n\
-        beqi    r3, done_len                                    \n\
-        brid    end_len                                         \n\
-        addik   r9, r9, 1                                       \n\
-done_len:                                                       \n\
-        rtsd    r15, 8                                          \n\
-        or      r3, r0, r9              /* Return len */        \n\
-align_arg:                                                      \n\
-        rsubik  r10, r3, 4                                      \n\
-align_loop:                                                     \n\
-        lbu     r3, r5, r9                                      \n\
-        beqid   r3, done_len                                    \n\
-        addik   r10, r10, -1                                    \n\
-        bneid   r10, align_loop                                 \n\
-        addik   r9, r9, 1                                       \n\
-        bri     len_loop");
-
-#endif  /* ! HAVE_HW_PCMP */
 }
+
+#endif /* !__HAVE_HW_PCMP__ */
