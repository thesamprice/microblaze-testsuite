+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <rtems/backtrace.h>
+
+#include <stdint.h>
+
+#include <tmacros.h>
+
+const char rtems_test_name[] = "BACKTRACE 1";
+
+/*
+ * The functions are small, so an address in a function is within this many
+ * bytes of its start.
+ */
+#define FUNCTION_SIZE_LIMIT 256
+
+typedef struct {
+  void *addresses[ 8 ];
+  int   count;
+  void *one[ 1 ];
+  int   count_one;
+  int   count_zero;
+} Test_Context;
+
+static Test_Context test_instance;
+
+static bool in_function( const void *address, void ( *function )( void ) )
+{
+  uintptr_t begin;
+
+  /* Ignore the Thumb bit */
+  begin = (uintptr_t) function & ~(uintptr_t) 1;
+
+  return (uintptr_t) address - begin < FUNCTION_SIZE_LIMIT;
+}
+
+/*
+ * The functions must not be inlined and the calls must not be tail calls,
+ * otherwise their frames do not appear in the backtrace.
+ */
+
+static RTEMS_NO_INLINE void f3( void )
+{
+  Test_Context *ctx;
+
+  ctx = &test_instance;
+  ctx->count = rtems_backtrace(
+    ctx->addresses,
+    RTEMS_ARRAY_SIZE( ctx->addresses )
+  );
+  ctx->count_one = rtems_backtrace( ctx->one, RTEMS_ARRAY_SIZE( ctx->one ) );
+  ctx->count_zero = rtems_backtrace( NULL, 0 );
+  RTEMS_COMPILER_MEMORY_BARRIER();
+}
+
+static RTEMS_NO_INLINE void f2( void )
+{
+  f3();
+  RTEMS_COMPILER_MEMORY_BARRIER();
+}
+
+static RTEMS_NO_INLINE void f1( void )
+{
+  f2();
+  RTEMS_COMPILER_MEMORY_BARRIER();
+}
+
+static rtems_task Init( rtems_task_argument argument )
+{
+  Test_Context *ctx;
+
+  (void) argument;
+
+  TEST_BEGIN();
+  ctx = &test_instance;
+
+  f1();
+  rtems_backtrace_print();
+
+  rtems_test_assert( ctx->count >= 3 );
+  rtems_test_assert( in_function( ctx->addresses[ 0 ], f3 ) );
+  rtems_test_assert( in_function( ctx->addresses[ 1 ], f2 ) );
+  rtems_test_assert( in_function( ctx->addresses[ 2 ], f1 ) );
+
+  rtems_test_assert( ctx->count_one == 1 );
+  rtems_test_assert( ctx->one[ 0 ] != ctx->addresses[ 0 ] );
+  rtems_test_assert( in_function( ctx->one[ 0 ], f3 ) );
+
+  rtems_test_assert( ctx->count_zero == 0 );
+
+  TEST_END();
+  rtems_test_exit( 0 );
+}
+
+#define CONFIGURE_APPLICATION_NEEDS_SIMPLE_CONSOLE_DRIVER
+
+#define CONFIGURE_APPLICATION_DOES_NOT_NEED_CLOCK_DRIVER
+
+#define CONFIGURE_MAXIMUM_TASKS 1
+
+#define CONFIGURE_INITIAL_EXTENSIONS RTEMS_TEST_INITIAL_EXTENSION
+
+#define CONFIGURE_RTEMS_INIT_TASKS_TABLE
+
+#define CONFIGURE_INIT
+
+#include <rtems/confdefs.h>
