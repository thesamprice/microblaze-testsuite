+#ifndef _RTEMS_BACKTRACE_H
+#define _RTEMS_BACKTRACE_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @defgroup RTEMSAPIBacktrace Backtrace Support
+ *
+ * @ingroup RTEMSAPIPrintSupport
+ *
+ * @brief This group contains functions which walk the stack of the
+ *   executing context.
+ *
+ * The walk uses the DWARF call frame information in the .eh_frame sections
+ * through _Unwind_Backtrace() of the compiler support library.  It stops at
+ * the first frame without call frame information, so only code compiled
+ * with -funwind-tables or -fasynchronous-unwind-tables, and assembly code
+ * with CFI directives, appears in a backtrace.
+ *
+ * The addresses are meant to be resolved offline, for example with
+ * rtems-addr2line.
+ *
+ * @{
+ */
+
+/**
+ * @brief Gets the backtrace of the caller.
+ *
+ * The first address is in the caller of rtems_backtrace().  Each address
+ * lies in the instruction which made the call of the next younger frame, or
+ * is the address of the interrupted instruction for a frame interrupted by an
+ * interrupt or exception.
+ *
+ * @param[out] addresses is the array which receives the addresses.
+ *
+ * @param size is the number of elements of the array.
+ *
+ * @return Returns the number of addresses stored in the array.
+ */
+int rtems_backtrace( void **addresses, int size );
+
+/**
+ * @brief Prints the backtrace of the caller with printk().
+ *
+ * Each line has the frame number and the address in hexadecimal notation,
+ * see rtems_backtrace().
+ */
+void rtems_backtrace_print( void );
+
+/** @} */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _RTEMS_BACKTRACE_H */
