+/* SPDX-License-Identifier: BSD-2-Clause */
+
+/**
+ * @file
+ *
+ * @ingroup RTEMSAPIBacktrace
+ *
+ * @brief This source file contains the implementation of rtems_backtrace()
+ *   and rtems_backtrace_print().
+ */
+
+/*
+ * Copyright (C) 2026 Samuel Price
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS "AS IS"
+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <rtems/backtrace.h>
+#include <rtems/bspIo.h>
+
+#include <inttypes.h>
+#include <stdint.h>
+#include <unwind.h>
+
+typedef struct {
+  void **addresses;
+  int    size;
+  int    count;
+} Backtrace_Context;
+
+static _Unwind_Reason_Code _Backtrace_Frame(
+  struct _Unwind_Context *uc,
+  void                   *arg
+)
+{
+  Backtrace_Context *ctx;
+  uintptr_t          pc;
+  int                ip_before_insn;
+
+  ctx = arg;
+
+  if ( ctx->count >= ctx->size ) {
+    return _URC_END_OF_STACK;
+  }
+
+  pc = _Unwind_GetIPInfo( uc, &ip_before_insn );
+
+  if ( pc == 0 ) {
+    return _URC_END_OF_STACK;
+  }
+
+  /*
+   * The walk starts with the frame of the function which called
+   * _Unwind_Backtrace().  Skip it, the backtrace starts with its caller.
+   */
+  if ( ctx->count >= 0 ) {
+    /*
+     * A return address is past the call.  Report an address in the call, so
+     * that it resolves to the line of the call.
+     */
+    if ( ip_before_insn == 0 ) {
+      --pc;
+    }
+
+    ctx->addresses[ ctx->count ] = (void *) pc;
+  }
+
+  ++ctx->count;
+  return _URC_NO_REASON;
+}
+
+static void _Backtrace_Initialize(
+  Backtrace_Context *ctx,
+  void             **addresses,
+  int                size
+)
+{
+  ctx->addresses = addresses;
+  ctx->size = size;
+  ctx->count = -1;
+}
+
+static int _Backtrace_Count( const Backtrace_Context *ctx )
+{
+  return ctx->count < 0 ? 0 : ctx->count;
+}
+
+int rtems_backtrace( void **addresses, int size )
+{
+  Backtrace_Context ctx;
+
+  _Backtrace_Initialize( &ctx, addresses, size );
+  (void) _Unwind_Backtrace( _Backtrace_Frame, &ctx );
+
+  return _Backtrace_Count( &ctx );
+}
+
+void rtems_backtrace_print( void )
+{
+  Backtrace_Context ctx;
+  void             *addresses[ 32 ];
+  int               count;
+  int               i;
+
+  _Backtrace_Initialize( &ctx, addresses, RTEMS_ARRAY_SIZE( addresses ) );
+  (void) _Unwind_Backtrace( _Backtrace_Frame, &ctx );
+  count = _Backtrace_Count( &ctx );
+
+  for ( i = 0; i < count; ++i ) {
+    printk( "#%i 0x%08" PRIxPTR "\n", i, (uintptr_t) addresses[ i ] );
+  }
+}
