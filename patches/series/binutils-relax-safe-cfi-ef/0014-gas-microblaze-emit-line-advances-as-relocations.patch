--- /dev/null
+++ b/gas/testsuite/gas/microblaze/dwarf2-fixed-advance.exp
@@ -0,0 +1,5 @@
+# Line table address advances on MicroBlaze.
+
+if [istarget microblaze*-*-*] {
+    run_dump_test "dwarf2-fixed-advance"
+}
diff --git a/gas/testsuite/gas/microblaze/dwarf2-fixed-advance.s b/gas/testsuite/gas/microblaze/dwarf2-fixed-advance.s
new file mode 100644
index 00000000000..dfbbd1aaf00
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/dwarf2-fixed-advance.s
@@ -0,0 +1,16 @@
+# Line table address advances are emitted as DW_LNS_fixed_advance_pc
+# with an ADD16/SUB16 pair, so that the linker can recompute them after
+# relaxation.
+
+	.file	1 "dwarf2-fixed-advance.c"
+	.text
+	.globl	f
+f:
+	.loc	1 1 0
+	addik	r1, r1, -8
+	.loc	1 2 0
+	brlid	r15, g
+	nop
+	.loc	1 3 0
+	rtsd	r15, 8
+	addik	r1, r1, 8
diff --git a/ld/testsuite/ld-microblaze/relax-line.d b/ld/testsuite/ld-microblaze/relax-line.d
new file mode 100644
index 00000000000..fd7b7021957
--- /dev/null
+++ b/ld/testsuite/ld-microblaze/relax-line.d
@@ -0,0 +1,19 @@
+#source: relax-line.s
+#as: -EL
+#ld: -EL -relax -T $srcdir/$subdir/relax-diff.ld
+#objdump: --dwarf=decodedline
+#name: MicroBlaze relaxation keeps line table rows with the code
+
+# Both IMMs are deleted, so each row after them moves back 4 or 8 bytes.
+# When the assembler resolved the advances, line 2 was at 0x90000008
+# (after the deleted IMM rather than at the brlid) and the sequence
+# ended at 0x90000024, inside far.
+
+#...
+relax-line.c +1 +0x90000000 .*
+relax-line.c +2 +0x90000004 .*
+relax-line.c +3 +0x9000000c .*
+relax-line.c +4 +0x90000014 .*
+relax-line.c +5 +0x90000018 .*
+relax-line.c +- +0x9000001c
+#pass
diff --git a/ld/testsuite/ld-microblaze/relax-line.s b/ld/testsuite/ld-microblaze/relax-line.s
new file mode 100644
index 00000000000..475dd367007
--- /dev/null
+++ b/ld/testsuite/ld-microblaze/relax-line.s
@@ -0,0 +1,27 @@
+/* _start loses two IMMs to relaxation.  The line table rows after them
+   must follow the code.  far is in another section, so the assembler
+   leaves the IMMs for the linker to delete.  */
+
+	.file	1 "relax-line.c"
+	.section .text.aaa,"ax",@progbits
+	.globl	_start
+	.type	_start, @function
+_start:
+	.loc	1 1 0
+	addik	r1, r1, -8
+	.loc	1 2 0
+	brlid	r15, far
+	nop
+	.loc	1 3 0
+	brlid	r15, far
+	nop
+	.loc	1 4 0
+	rtsd	r15, 8
+	.loc	1 5 0
+	addik	r1, r1, 8
+	.size	_start, .-_start
+
+	.section .text.zz,"ax",@progbits
+far:
+	rtsd	r15, 8
+	nop
-- 
