index f5da32cb4d9..7da3b2f405a 100644
--- a/gas/config/tc-microblaze.h
+++ b/gas/config/tc-microblaze.h
@@ -133,6 +133,12 @@ extern void 	 cons_fix_new_microblaze       (fragS *, int, int,
    one frag into relocations, since linker relaxation can change it.  */
 #define md_pre_output_hook microblaze_pre_output_hook ()
 extern void microblaze_pre_output_hook (void);
+
+/* Advance the address in gas-generated line tables with
+   DW_LNS_fixed_advance_pc, whose operand is a 16-bit difference of code
+   labels and so becomes an ADD16/SUB16 pair the linker can recompute
+   after relaxation.  From tc-riscv.h.  */
+#define DWARF2_USE_FIXED_ADVANCE_PC(FROM, TO) 1
 #define DWARF2_CIE_DATA_ALIGNMENT -4
 #define DWARF2_DEFAULT_RETURN_COLUMN 15
 
