index 00000000000..2f377e52bde
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/dwarf2-fixed-advance.d
@@ -0,0 +1,18 @@
+#objdump: -r -j .debug_line
+#name: MicroBlaze line table advances as relocations
+#source: dwarf2-fixed-advance.s
+
+# Each advance is a DW_LNS_fixed_advance_pc operand with an ADD16
+# against the new address and a SUB16 against the old one.
+
+.*: +file format .*
+
+RELOCATION RECORDS FOR \[\.debug_line\]:
+OFFSET +TYPE +VALUE
+[0-9a-f]+ R_MICROBLAZE_32 +\.text
+[0-9a-f]+ R_MICROBLAZE_ADD16 +\.text\+0x0+8
+[0-9a-f]+ R_MICROBLAZE_SUB16 +.*
+[0-9a-f]+ R_MICROBLAZE_ADD16 +\.text\+0x0+10
+[0-9a-f]+ R_MICROBLAZE_SUB16 +.*
+[0-9a-f]+ R_MICROBLAZE_ADD16 +\.text\+0x0+18
+[0-9a-f]+ R_MICROBLAZE_SUB16 +.*
