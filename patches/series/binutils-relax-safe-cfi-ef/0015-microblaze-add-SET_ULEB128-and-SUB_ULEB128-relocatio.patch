 };
 
 #ifndef NUM_ELEM
@@ -869,6 +919,12 @@ microblaze_elf_reloc_type_lookup (bfd * abfd ATTRIBUTE_UNUSED,
     case BFD_RELOC_MICROBLAZE_SET6:
