@@ -1192,6 +1248,34 @@ microblaze_elf_output_dynamic_relocation (bfd *output_bfd,
 	      (sreloc->contents + reloc_index * sizeof (Elf32_External_Rela)));
 }
 
+/* Write VALUE as a ULEB128 at P, in exactly the number of bytes the
+   ULEB128 already there occupies, padding with continuation bytes.
+   END is the end of the section.  Return false if the field is not a
+   valid ULEB128 or VALUE does not fit in it.  */
+
+static bool
+microblaze_write_uleb128 (bfd_byte *p, bfd_byte *end, bfd_vma value)
+{
+  size_t len, i;
+
+  for (len = 0; p + len < end && (p[len] & 0x80) != 0; len++)
+    ;
+  if (p + len >= end)
+    return false;
+  len++;
+
+  for (i = 0; i < len; i++)
+    {
+      bfd_byte c = value & 0x7f;
+
+      value >>= 7;
+      if (i + 1 < len)
+	c |= 0x80;
+      p[i] = c;
+    }
+  return value == 0;
+}
+
 /* This code is taken from elf32-m32r.c
    There is some attempt to make this function usable for many architectures,
    both USE_REL and USE_RELA ['twould be nice if such a critter existed],
@@ -1245,6 +1329,9 @@ microblaze_elf_relocate_section (struct bfd_link_info *info,
   asection *sreloc;
   bfd_vma *local_got_offsets;
   unsigned int tls_type;
+  /* The R_MICROBLAZE_SET_ULEB128 waiting for its SUB_ULEB128.  */
+  Elf_Internal_Rela *uleb128_set_rel = NULL;
+  bfd_vma uleb128_set_value = 0;
 
   if (!microblaze_elf_howto_table[R_MICROBLAZE_max-1])
     microblaze_elf_howto_init ();
@@ -1543,6 +1630,32 @@ microblaze_elf_relocate_section (struct bfd_link_info *info,
 	      }
 	      break;
 
+	    case (int) R_MICROBLAZE_SET_ULEB128:
+	      uleb128_set_rel = rel;
+	      uleb128_set_value = relocation + addend;
+	      break;
+
+	    case (int) R_MICROBLAZE_SUB_ULEB128:
+	      /* As on RISC-V, the SET comes first at the same offset.  */
+	      if (uleb128_set_rel == NULL
+		  || uleb128_set_rel->r_offset != rel->r_offset)
+		{
+		  errmsg = _("R_MICROBLAZE_SUB_ULEB128 without a preceding "
+			     "R_MICROBLAZE_SET_ULEB128 at the same offset");
+		  r = bfd_reloc_dangerous;
+		}
+	      else if (!microblaze_write_uleb128
+			 (contents + offset,
+			  contents + bfd_get_section_limit (input_bfd,
+							    input_section),
+			  uleb128_set_value - (relocation + addend)))
+		{
+		  errmsg = _("ULEB128 difference does not fit its field");
+		  r = bfd_reloc_dangerous;
+		}
+	      uleb128_set_rel = NULL;
+	      break;
+
 	    case (int) R_MICROBLAZE_GOTPC_64:
 	      relocation = (htab->elf.sgotplt->output_section->vma
 			    + htab->elf.sgotplt->output_offset);
@@ -2061,6 +2174,8 @@ microblaze_diff_reloc_p (int r_type)
     case R_MICROBLAZE_SUB16:
     case R_MICROBLAZE_SUB32:
     case R_MICROBLAZE_SET6:
+    case R_MICROBLAZE_SET_ULEB128:
+    case R_MICROBLAZE_SUB_ULEB128:
       return true;
     default:
       return false;
@@ -2330,6 +2445,8 @@ microblaze_elf_relax_section (bfd *abfd,
 	    case R_MICROBLAZE_SUB16:
 	    case R_MICROBLAZE_SUB32:
 	    case R_MICROBLAZE_SET6:
+	    case R_MICROBLAZE_SET_ULEB128:
+	    case R_MICROBLAZE_SUB_ULEB128:
 	      /* If this reloc is against a symbol defined in this
 		 section, we must check the addend to see it will put the value in
 		 range to be adjusted, and hence must be changed.  */
