+/* Special function for the ULEB128 relocations.  The assembler has
+   already written the difference, which is correct for an object that
+   has not been relaxed; only microblaze_elf_relocate_section recomputes
+   it.  From riscv_elf_ignore_reloc in elfxx-riscv.c.  */
+
+static bfd_reloc_status_type
+microblaze_elf_ignore_reloc (bfd *abfd ATTRIBUTE_UNUSED,
+			     arelent *reloc_entry,
+			     asymbol *symbol ATTRIBUTE_UNUSED,
+			     void *data ATTRIBUTE_UNUSED,
+			     asection *input_section,
+			     bfd *output_bfd,
+			     char **error_message ATTRIBUTE_UNUSED)
+{
+  if (output_bfd != NULL)
+    reloc_entry->address += input_section->output_offset;
+  return bfd_reloc_ok;
+}
+
 static reloc_howto_type microblaze_elf_howto_raw[] =
 {
    /* This reloc does nothing.  */
@@ -721,6 +740,37 @@ static reloc_howto_type microblaze_elf_howto_raw[] =
 	 0x3f,		/* dst_mask */
 	 false),		/* pcrel_offset */
 
+   /* ULEB128 setting, for the difference of two labels.  Paired with
+      a following R_MICROBLAZE_SUB_ULEB128 at the same offset.  */
+   HOWTO (R_MICROBLAZE_SET_ULEB128,
+	 0,			/* rightshift */
+	 0,			/* size */
+	 0,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 microblaze_elf_ignore_reloc, /* special_function */
+	 "R_MICROBLAZE_SET_ULEB128", /* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0,			/* dst_mask */
+	 false),		/* pcrel_offset */
+
+   /* ULEB128 subtraction, for the difference of two labels.  */
+   HOWTO (R_MICROBLAZE_SUB_ULEB128,
+	 0,			/* rightshift */
+	 0,			/* size */
+	 0,			/* bitsize */
+	 false,			/* pc_relative */
+	 0,			/* bitpos */
+	 complain_overflow_dont, /* complain_on_overflow */
+	 microblaze_elf_ignore_reloc, /* special_function */
+	 "R_MICROBLAZE_SUB_ULEB128", /* name */
+	 false,			/* partial_inplace */
+	 0,			/* src_mask */
+	 0,			/* dst_mask */
