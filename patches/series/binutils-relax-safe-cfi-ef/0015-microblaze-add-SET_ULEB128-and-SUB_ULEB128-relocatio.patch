diff --git a/binutils/readelf.c b/binutils/readelf.c
index 4ee5e39d2a5..920f75a062a 100644
--- a/binutils/readelf.c
+++ b/binutils/readelf.c
@@ -15242,6 +15242,81 @@ target_specific_reloc_handling (Filedata *filedata,
 
   switch (filedata->file_header.e_machine)
     {
+    case EM_MICROBLAZE:
+      {
+	static uint64_t saved_value;
+	static uint64_t saved_offset = (uint64_t) -1;
+
+	if (reloc == NULL)
+	  {
+	    saved_offset = (uint64_t) -1;
+	    return true;
+	  }
+
+	switch (reloc_type)
+	  {
+	  case 44: /* R_MICROBLAZE_SET_ULEB128.  */
+	  case 45: /* R_MICROBLAZE_SUB_ULEB128.  */
+	    {
+	      uint64_t value;
+	      unsigned int reloc_size = 0;
+	      int leb_ret = 0;
+
+	      if (sym_index >= num_syms)
+		{
+		  error (_("%s reloc contains invalid symbol index "
+			   "%" PRIu64 "\n"),
+			 (reloc_type == 44
+			  ? "R_MICROBLAZE_SET_ULEB128"
+			  : "R_MICROBLAZE_SUB_ULEB128"),
+			 sym_index);
+		  return true;
+		}
+	      value = reloc->r_addend + symtab[sym_index].st_value;
+	      if (reloc_type == 44)
+		{
+		  saved_value = value;
+		  saved_offset = reloc->r_offset;
+		  return true;
+		}
+	      if (saved_offset != reloc->r_offset)
+		{
+		  error (_("R_MICROBLAZE_SUB_ULEB128 at %#" PRIx64
+			   " does not follow an R_MICROBLAZE_SET_ULEB128\n"),
+			 reloc->r_offset);
+		  return true;
+		}
+	      saved_offset = (uint64_t) -1;
+	      value = saved_value - value;
+
+	      if (reloc->r_offset < size)
+		read_leb128 (start + reloc->r_offset, start + size, false,
+			     &reloc_size, &leb_ret);
+	      if (leb_ret != 0 || reloc_size == 0 || reloc_size > 8)
+		{
+		  error (_("MicroBlaze ULEB128 field at %#" PRIx64
+			   " contains invalid ULEB128 value\n"),
+			 reloc->r_offset);
+		  return true;
+		}
+
+	      /* Rewrite it in the same number of bytes.  */
+	      bfd_byte *p = start + reloc->r_offset;
+	      do
+		{
+		  bfd_byte c = value & 0x7f;
+		  value >>= 7;
+		  if (--reloc_size != 0)
+		    c |= 0x80;
+		  *p++ = c;
+		}
+	      while (reloc_size);
+	      return true;
+	    }
+	  }
+	break;
+      }
+
     case EM_LOONGARCH:
       {
 	switch (reloc_type)
diff --git a/gas/config/tc-microblaze.c b/gas/config/tc-microblaze.c
index 244f03872d5..5398e59667a 100644
--- a/gas/config/tc-microblaze.c
+++ b/gas/config/tc-microblaze.c
@@ -2114,10 +2114,51 @@ microblaze_cfa_fix (fixS *fixP)
 		      fixP->fx_size);
 }
 
+/* If FRAG, in section S and frag chain FRCH, is a .uleb128 of a
+   difference of labels in one code section that the assembler could not
+   resolve when it was parsed, give it a SET_ULEB128 and SUB_ULEB128
+   pair.  Such a difference spans an IMM that linker relaxation may
+   delete.  From riscv_insert_uleb128_fixes in tc-riscv.c.  */
+
+static void
+microblaze_uleb128_fix (segT s, const frchainS *frch, fragS *frag)
+{
+  expressionS *exp;
+  expressionS sym;
+  segT seg;
+
+  if (frag->fr_symbol == NULL || frag->fr_subtype != 0)
+    return;
+
+  exp = symbol_get_value_expression (frag->fr_symbol);
+  if (exp->X_op != O_subtract
+      || !S_IS_DEFINED (exp->X_add_symbol)
+      || !S_IS_DEFINED (exp->X_op_symbol))
+    return;
+  seg = S_GET_SEGMENT (exp->X_add_symbol);
+  if (seg != S_GET_SEGMENT (exp->X_op_symbol)
+      || (seg->flags & SEC_CODE) == 0)
+    return;
+
+  subseg_set (s, frch->frch_subseg);
+
+  memset (&sym, 0, sizeof sym);
+  sym.X_op = O_symbol;
+  sym.X_add_symbol = exp->X_add_symbol;
+  sym.X_add_number = exp->X_add_number;
+  fix_new_exp (frag, frag->fr_fix, 0, &sym, 0,
+	       BFD_RELOC_MICROBLAZE_SET_ULEB128);
+  sym.X_add_symbol = exp->X_op_symbol;
+  sym.X_add_number = 0;
+  fix_new_exp (frag, frag->fr_fix, 0, &sym, 0,
+	       BFD_RELOC_MICROBLAZE_SUB_ULEB128);
+}
+
 /* Give each rs_cfa frag, a DW_CFA_advance_loc whose two labels are in
    different frags, a BFD_RELOC_MICROBLAZE_CFA fixup.  An IMM that linker
    relaxation may delete ends a frag, so these are the advances that can
-   change.  From riscv_pre_output_hook in tc-riscv.c.  */
+   change.  From riscv_pre_output_hook in tc-riscv.c.  Give .uleb128
+   differences their relocations too; see microblaze_uleb128_fix.  */
 
 void
 microblaze_pre_output_hook (void)
@@ -2154,6 +2195,8 @@ microblaze_pre_output_hook (void)
 		fix_new_exp (frag, (int) frag->fr_offset, 1, &exp, 0,
 			     BFD_RELOC_MICROBLAZE_CFA);
 	      }
+	    else if (frag->fr_type == rs_leb128)
+	      microblaze_uleb128_fix (s, frch, frag);
 	  }
       }
 
@@ -2318,6 +2361,11 @@ md_apply_fix (fixS *   fixP,
       fixP->fx_done = 1;
       return;
 
+    case BFD_RELOC_MICROBLAZE_SET_ULEB128:
+    case BFD_RELOC_MICROBLAZE_SUB_ULEB128:
+      /* cvt_frag_to_fill has written the difference.  */
+      break;
+
     case BFD_RELOC_32:
     case BFD_RELOC_RVA:
     case BFD_RELOC_32_PCREL:
@@ -2658,6 +2706,8 @@ tc_gen_reloc (asection * section ATTRIBUTE_UNUSED, fixS * fixp)
     case BFD_RELOC_MICROBLAZE_SUB16:
     case BFD_RELOC_MICROBLAZE_SUB32:
     case BFD_RELOC_MICROBLAZE_SET6:
+    case BFD_RELOC_MICROBLAZE_SET_ULEB128:
+    case BFD_RELOC_MICROBLAZE_SUB_ULEB128:
       code = fixp->fx_r_type;
       break;
 
