@@ -0,0 +1,13 @@
+#source: relax-uleb128.s
+#as: -EL
+#ld: -EL -relax -T $srcdir/$subdir/relax-diff.ld
+#objdump: -s -j .data
+#name: MicroBlaze relaxation recomputes ULEB128 differences
+
+# 124 is 0xfc 0x00 padded to the field's two bytes, and 123 is 0xfb 0x00.
+# Without the relocations they stay 0x84 0x01 (132) and 0x83 0x01 (131).
+
+.*: +file format .*
+
+Contents of section \.data:
+ 90001000 fc00fb00 +.*
diff --git a/ld/testsuite/ld-microblaze/relax-uleb128.s b/ld/testsuite/ld-microblaze/relax-uleb128.s
new file mode 100644
index 00000000000..6ddc97c2cb3
--- /dev/null
+++ b/ld/testsuite/ld-microblaze/relax-uleb128.s
@@ -0,0 +1,26 @@
+/* Two IMMs between a and b are deleted by relaxation, so each
+   difference below shrinks by 8.  b - a is 132 as assembled, a 2-byte
+   ULEB128, and 124 after relaxation, which fits in one byte but must be
+   written in the two the field occupies.  */
+
+	.section .text.aaa,"ax",@progbits
+	.globl	_start
+_start:
+a:
+	brlid	r15, far
+	nop
+	brlid	r15, far
+	nop
+	.space	108
+b:
+	rtsd	r15, 8
+	nop
+
+	.section .text.zz,"ax",@progbits
+far:
+	rtsd	r15, 8
+	nop
+
+	.data
+	.uleb128 b - a
+	.uleb128 b - 1 - a
