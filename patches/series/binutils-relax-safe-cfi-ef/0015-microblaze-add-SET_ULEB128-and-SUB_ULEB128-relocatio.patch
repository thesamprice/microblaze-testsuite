+#objdump: -r -s -j .data
+#name: MicroBlaze ULEB128 differences of code labels
+#source: reloc_uleb128.s
+
+.*: +file format .*
+
+RELOCATION RECORDS FOR \[\.data\]:
+OFFSET +TYPE +VALUE
+0+0000 R_MICROBLAZE_SET_ULEB128 +\.text\+0x0+c
+0+0000 R_MICROBLAZE_SUB_ULEB128 +\.text
+0+0001 R_MICROBLAZE_SET_ULEB128 +\.text\+0x0+b
+0+0001 R_MICROBLAZE_SUB_ULEB128 +\.text
+
+
+Contents of section \.data:
+ 0000 0c0b00 +.*
diff --git a/gas/testsuite/gas/microblaze/reloc_uleb128.s b/gas/testsuite/gas/microblaze/reloc_uleb128.s
new file mode 100644
index 00000000000..76c653e99c3
--- /dev/null
+++ b/gas/testsuite/gas/microblaze/reloc_uleb128.s
@@ -0,0 +1,15 @@
+# .uleb128 of a difference of code labels that spans an IMM, which
+# linker relaxation may delete, is left to the linker as a SET_ULEB128
+# and SUB_ULEB128 pair.  The field holds the difference as assembled.
+
+	.text
+a:
+	brlid	r15, ext
+	nop
+b:
+	nop
+
+	.data
+	.uleb128 b - a
+	.uleb128 b - 1 - a
+	.uleb128 a - a
